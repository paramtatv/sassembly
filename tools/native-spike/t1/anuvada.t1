    पर भवति ऋण१ ।   ॰ r = -1
    यदि पइ समम् ० आदि   ॰ if i == 0:
        पर भवति वृबलओचकतअरगएत पभ ।   ॰ r = block_target(v)
    इति अन्यथा आदि
        पटम१ भवति वृफअललसतहरओउगह पओप ।   ॰ elif falls_through(op) or ((op == K_JAL or op == K_JALR) and RD[k] !=
        पटम२ भवति ० ।   ॰ elif falls_through(op) or ((op == K_JAL or op == K_JALR) and RD[k] !=
        यदि पटम१ असमम् ० आदि   ॰ elif falls_through(op) or ((op == K_JAL or op == K_JALR) and RD[k] !=
            पटम२ भवति १ ।
        इति
        यदि पटम२ समम् ० आदि   ॰ elif falls_through(op) or ((op == K_JAL or op == K_JALR) and RD[k] !=
            पटम३ भवति ० ।   ॰ elif falls_through(op) or ((op == K_JAL or op == K_JALR) and RD[k] !=
            यदि पओप समम् ३ आदि   ॰ elif falls_through(op) or ((op == K_JAL or op == K_JALR) and RD[k] !=
                पटम३ भवति १ ।
            इति
            यदि पटम३ समम् ० आदि   ॰ elif falls_through(op) or ((op == K_JAL or op == K_JALR) and RD[k] !=
                पटम४ भवति ० ।   ॰ elif falls_through(op) or ((op == K_JAL or op == K_JALR) and RD[k] !=
                यदि पओप समम् ४ आदि   ॰ elif falls_through(op) or ((op == K_JAL or op == K_JALR) and RD[k] !=
                    पटम४ भवति १ ।
                इति
                पटम३ भवति पटम४ ।
            इति
            यदि पटम३ समम् १ आदि   ॰ elif falls_through(op) or ((op == K_JAL or op == K_JALR) and RD[k] !=
                पटम५ भवति लक्ष्याणि अङ्कः पक अन्तः ।   ॰ elif falls_through(op) or ((op == K_JAL or op == K_JALR) and RD[k] !=
                पटम६ भवति ० ।   ॰ elif falls_through(op) or ((op == K_JAL or op == K_JALR) and RD[k] !=
                यदि पटम५ असमम् ० आदि   ॰ elif falls_through(op) or ((op == K_JAL or op == K_JALR) and RD[k] !=
                    पटम६ भवति १ ।
                इति
                पटम३ भवति पटम६ ।
            इति
            पटम२ भवति पटम३ ।
        इति
        यदि पटम२ समम् १ आदि   ॰ elif falls_through(op) or ((op == K_JAL or op == K_JALR) and RD[k] !=
            पर भवति पभ योगः १ ।   ॰ r = v + 1
        इति
    इति
    पटम१ भवति ० ।   ॰ if r < SEGLO or r >= SEGHI:
    यदि पर न्यूनम् वासएगलओ आदि   ॰ if r < SEGLO or r >= SEGHI:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् ० आदि   ॰ if r < SEGLO or r >= SEGHI:
        पटम२ भवति ० ।   ॰ if r < SEGLO or r >= SEGHI:
        यदि पर बृहत्समम् वासएगहइ आदि   ॰ if r < SEGLO or r >= SEGHI:
            पटम२ भवति १ ।
        इति
        पटम१ भवति पटम२ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if r < SEGLO or r >= SEGHI:
        पर भवति ऋण१ ।   ॰ r = -1
    इति
    प्रत्यागमनम् पर ।   ॰ return r
इति

॰ fast_order -> वृफअसतओरदएर
वृत्तिः वृफअसतओरदएर आदाय पअ ॱॱ अ६४ ऽ पब ॱॱ अ६४ ददाति अ६४ आदि
