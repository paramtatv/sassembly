        इति अन्यथा आदि
            पटम१ भवति पअ योगः पचनत ।   ॰ ORD[a + cnt] = found
            वाओरद अङ्कः पटम१ अन्तः भवति पफओउनद ।   ॰ ORD[a + cnt] = found
            पटम१ भवति पअ योगः पचनत ।   ॰ POS[found] = a + cnt
            वापओस अङ्कः पफओउनद अन्तः भवति पटम१ ।   ॰ POS[found] = a + cnt
            पचनत भवति पचनत योगः १ ।   ॰ cnt += 1
            पटम१ भवति वाइसह अङ्कः पफओउनद अन्तः ।   ॰ if ISH[found]:
            पटम२ भवति ० ।   ॰ if ISH[found]:
            यदि पटम१ असमम् ० आदि   ॰ if ISH[found]:
                पटम२ भवति १ ।
            इति
            यदि पटम२ समम् १ आदि   ॰ if ISH[found]:
                वारसतक अङ्कः परस अन्तः भवति पफओउनद ।   ॰ RSTK[rs] = found
                पटम२ भवति वारपओन अङ्कः पफओउनद अन्तः ।   ॰ RCUR[rs] = RPON[found] + 1
                पटम१ भवति पटम२ योगः १ ।   ॰ RCUR[rs] = RPON[found] + 1
                वारचउर अङ्कः परस अन्तः भवति पटम१ ।   ॰ RCUR[rs] = RPON[found] + 1
                परस भवति परस योगः १ ।   ॰ rs += 1
            इति
        इति
    इति
    पप भवति पअ ।   ॰ for p in range(a, b):
    पस्थिर१८ भवति पब ।   ॰ for p in range(a, b):
    यावत् पप न्यूनम् पस्थिर१८ आदि   ॰ for p in range(a, b):
        पभ भवति वाओरद अङ्कः पप अन्तः ।   ॰ v = ORD[p]
        वालएनद अङ्कः पप अन्तः भवति ऋण१ ।   ॰ LEND[p] = -1
        वालपअर अङ्कः पप अन्तः भवति ऋण१ ।   ॰ LPAR[p] = -1
        वाइननएर अङ्कः पप अन्तः भवति ऋण१ ।   ॰ INNER[p] = -1
        पटम१ भवति वाइसह अङ्कः पभ अन्तः ।   ॰ if ISH[v]:
        पटम२ भवति ० ।   ॰ if ISH[v]:
        यदि पटम१ असमम् ० आदि   ॰ if ISH[v]:
            पटम२ भवति १ ।
        इति
        यदि पटम२ समम् १ आदि   ॰ if ISH[v]:
            पटम३ भवति वालसइशए अङ्कः पभ अन्तः ।   ॰ LEND[p] = p + LSIZE[v] - 1
            पटम२ भवति पप योगः पटम३ ।   ॰ LEND[p] = p + LSIZE[v] - 1
            पटम१ भवति पटम२ वियोगः १ ।   ॰ LEND[p] = p + LSIZE[v] - 1
            वालएनद अङ्कः पप अन्तः भवति पटम१ ।   ॰ LEND[p] = p + LSIZE[v] - 1
            पटम१ भवति वालपअरह अङ्कः पभ अन्तः ।   ॰ if LPARH[v] >= 0:
            यदि पटम१ बृहत्समम् ० आदि   ॰ if LPARH[v] >= 0:
                पटम२ भवति वालपअरह अङ्कः पभ अन्तः ।   ॰ LPAR[p] = POS[LPARH[v]]
                पटम१ भवति वापओस अङ्कः पटम२ अन्तः ।   ॰ LPAR[p] = POS[LPARH[v]]
                वालपअर अङ्कः पप अन्तः भवति पटम१ ।   ॰ LPAR[p] = POS[LPARH[v]]
            इति
        इति
        पटम१ भवति वालओओपह अङ्कः पभ अन्तः ।   ॰ if LOOPH[v] >= 0:
        यदि पटम१ बृहत्समम् ० आदि   ॰ if LOOPH[v] >= 0:
            पटम२ भवति वालओओपह अङ्कः पभ अन्तः ।   ॰ INNER[p] = POS[LOOPH[v]]
            पटम१ भवति वापओस अङ्कः पटम२ अन्तः ।   ॰ INNER[p] = POS[LOOPH[v]]
            वाइननएर अङ्कः पप अन्तः भवति पटम१ ।   ॰ INNER[p] = POS[LOOPH[v]]
        इति
        पप भवति पप योगः १ ।
    इति
    प्रत्यागमनम् ० ।
इति

॰ path_from -> वृपअतहफरओम
वृत्तिः वृपअतहफरओम आदाय पस ॱॱ अ६४ ददाति अ६४ आदि
    चरः पर ॱॱ अ६४ भवति ० ।
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    पर भवति वालपअतह अङ्कः पस अन्तः ।   ॰ r = LPATH[s]
    पटम१ भवति वालएनद अङ्कः पस अन्तः ।   ॰ if LEND[s] >= 0:
    यदि पटम१ बृहत्समम् ० आदि   ॰ if LEND[s] >= 0:
        पर भवति ० ।   ॰ r = 0
    इति
    प्रत्यागमनम् पर ।   ॰ return r
इति

॰ edge_cost -> वृएदगएचओसत
वृत्तिः वृएदगएचओसत आदाय पअ ॱॱ अ६४ ऽ पब ॱॱ अ६४ ऽ पप ॱॱ अ६४ ऽ पत ॱॱ अ६४ ददाति अ६४ आदि
    चरः पउ ॱॱ अ६४ भवति ० ।
    चरः पच ॱॱ अ६४ भवति ० ।
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    पउ भवति वृतहरएअद पत ।   ॰ u = thread(t)
    पच भवति वातहरएअदष ।   ॰ c = THREADX
    पटम१ भवति ० ।   ॰ if u >= a and u < b:
    यदि पउ बृहत्समम् पअ आदि   ॰ if u >= a and u < b:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if u >= a and u < b:
        पटम२ भवति ० ।   ॰ if u >= a and u < b:
        यदि पउ न्यूनम् पब आदि   ॰ if u >= a and u < b:
            पटम२ भवति १ ।
        इति
        पटम१ भवति पटम२ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if u >= a and u < b:
        पटम१ भवति वापओस अङ्कः पउ अन्तः ।   ॰ if POS[u] > p:
        यदि पटम१ अधिकम् पप आदि   ॰ if POS[u] > p:
            पटम२ भवति वापओस अङ्कः पउ अन्तः ।   ॰ c = c + path_from(POS[u])
            पटम१ भवति वृपअतहफरओम पटम२ ।   ॰ c = c + path_from(POS[u])
            पच भवति पच योगः पटम१ ।   ॰ c = c + path_from(POS[u])
        इति
    इति
    प्रत्यागमनम् पच ।   ॰ return c
इति

॰ fast_paths -> वृफअसतपअतहस
वृत्तिः वृफअसतपअतहस आदाय पअ ॱॱ अ६४ ऽ पब ॱॱ अ६४ ददाति अ६४ आदि
    चरः पव ॱॱ अ६४ भवति ० ।
    चरः पप ॱॱ अ६४ भवति ० ।
    चरः पभ ॱॱ अ६४ भवति ० ।
    चरः पक ॱॱ अ६४ भवति ० ।
    चरः पओप ॱॱ अ६४ भवति ० ।
    चरः पम ॱॱ अ६४ भवति ० ।
    चरः पत ॱॱ अ६४ भवति ० ।
    चरः पच ॱॱ अ६४ भवति ० ।
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    चरः पटम३ ॱॱ अ६४ भवति ० ।
    चरः पटम४ ॱॱ अ६४ भवति ० ।
    चरः पटम५ ॱॱ अ६४ भवति ० ।
    चरः पटम६ ॱॱ अ६४ भवति ० ।
    पव भवति ० ।   ॰ w = 0
    पप भवति पब वियोगः १ ।   ॰ p = b - 1
    यावत् पप बृहत्समम् पअ आदि   ॰ while p >= a:
        पभ भवति वाओरद अङ्कः पप अन्तः ।   ॰ v = ORD[p]
        पटम२ भवति वासतअरतस अङ्कः पभ अन्तः ।   ॰ k = STARTS[v] + BLEN[v] - 1
        पटम३ भवति वाबलएन अङ्कः पभ अन्तः ।   ॰ k = STARTS[v] + BLEN[v] - 1
        पटम१ भवति पटम२ योगः पटम३ ।   ॰ k = STARTS[v] + BLEN[v] - 1
        पक भवति पटम१ वियोगः १ ।   ॰ k = STARTS[v] + BLEN[v] - 1
        पओप भवति क्रियाः अङ्कः पक अन्तः ।   ॰ op = OPS[k]
        पम भवति ० ।   ॰ m = 0
        पटम१ भवति वृफअललसतहरओउगह पओप ।   ॰ if falls_through(op) and v + 1 < NBLK:
        पटम२ भवति ० ।   ॰ if falls_through(op) and v + 1 < NBLK:
        यदि पटम१ असमम् ० आदि   ॰ if falls_through(op) and v + 1 < NBLK:
            पटम२ भवति १ ।
        इति
        यदि पटम२ समम् १ आदि   ॰ if falls_through(op) and v + 1 < NBLK:
            पटम३ भवति पभ योगः १ ।   ॰ if falls_through(op) and v + 1 < NBLK:
            पटम४ भवति ० ।   ॰ if falls_through(op) and v + 1 < NBLK:
            यदि पटम३ न्यूनम् वानबलक आदि   ॰ if falls_through(op) and v + 1 < NBLK:
                पटम४ भवति १ ।
            इति
            पटम२ भवति पटम४ ।
        इति
        यदि पटम२ समम् १ आदि   ॰ if falls_through(op) and v + 1 < NBLK:
            पटम१ भवति पभ योगः १ ।   ॰ if v + 1 < b and POS[v + 1] == p + 1:
            पटम२ भवति ० ।   ॰ if v + 1 < b and POS[v + 1] == p + 1:
            यदि पटम१ न्यूनम् पब आदि   ॰ if v + 1 < b and POS[v + 1] == p + 1:
                पटम२ भवति १ ।
            इति
            यदि पटम२ समम् १ आदि   ॰ if v + 1 < b and POS[v + 1] == p + 1:
                पटम४ भवति पभ योगः १ ।   ॰ if v + 1 < b and POS[v + 1] == p + 1:
                पटम३ भवति वापओस अङ्कः पटम४ अन्तः ।   ॰ if v + 1 < b and POS[v + 1] == p + 1:
                पटम५ भवति पप योगः १ ।   ॰ if v + 1 < b and POS[v + 1] == p + 1:
                पटम६ भवति ० ।   ॰ if v + 1 < b and POS[v + 1] == p + 1:
                यदि पटम३ समम् पटम५ आदि   ॰ if v + 1 < b and POS[v + 1] == p + 1:
                    पटम६ भवति १ ।
                इति
                पटम२ भवति पटम६ ।
            इति
            यदि पटम२ समम् १ आदि   ॰ if v + 1 < b and POS[v + 1] == p + 1:
                पटम१ भवति पप योगः १ ।   ॰ m = path_from(p + 1)
                पम भवति वृपअतहफरओम पटम१ ।   ॰ m = path_from(p + 1)
            इति अन्यथा आदि
                पटम१ भवति पभ योगः १ ।   ॰ m = edge_cost(a, b, p, v + 1)
                पम भवति वृएदगएचओसत आरभ्य पअ ऽ पब ऽ पप ऽ पटम१ समाप्तम् ।   ॰ m = edge_cost(a, b, p, v + 1)
            इति
        इति
        पटम१ भवति ० ।   ॰ if op == K_JAL or (op >= K_BEQ and op <= K_BGEU):
        यदि पओप समम् ३ आदि   ॰ if op == K_JAL or (op >= K_BEQ and op <= K_BGEU):
            पटम१ भवति १ ।
        इति
        यदि पटम१ समम् ० आदि   ॰ if op == K_JAL or (op >= K_BEQ and op <= K_BGEU):
            पटम२ भवति ० ।   ॰ if op == K_JAL or (op >= K_BEQ and op <= K_BGEU):
            यदि पओप बृहत्समम् ५ आदि   ॰ if op == K_JAL or (op >= K_BEQ and op <= K_BGEU):
                पटम२ भवति १ ।
            इति
            यदि पटम२ समम् १ आदि   ॰ if op == K_JAL or (op >= K_BEQ and op <= K_BGEU):
                पटम३ भवति ० ।   ॰ if op == K_JAL or (op >= K_BEQ and op <= K_BGEU):
                यदि १० बृहत्समम् पओप आदि   ॰ if op == K_JAL or (op >= K_BEQ and op <= K_BGEU):
                    पटम३ भवति १ ।
                इति
                पटम२ भवति पटम३ ।
            इति
            पटम१ भवति पटम२ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if op == K_JAL or (op >= K_BEQ and op <= K_BGEU):
            पटम२ भवति ४ गुणनम् पक ।   ॰ t = direct_target(WG_BASE + 4 * k, IMM[k])
            पटम१ भवति वावगबअसए योगः पटम२ ।   ॰ t = direct_target(WG_BASE + 4 * k, IMM[k])
            पटम३ भवति मात्राः अङ्कः पक अन्तः ।   ॰ t = direct_target(WG_BASE + 4 * k, IMM[k])
            पत भवति वृदइरएचततअरगएत आरभ्य पटम१ ऽ पटम३ समाप्तम् ।   ॰ t = direct_target(WG_BASE + 4 * k, IMM[k])
            यदि पत बृहत्समम् ० आदि   ॰ if t >= 0:
                पच भवति वृएदगएचओसत आरभ्य पअ ऽ पब ऽ पप ऽ पत समाप्तम् ।   ॰ c = edge_cost(a, b, p, t)
                यदि पच अधिकम् पम आदि   ॰ if c > m:
                    पम भवति पच ।   ॰ m = c
                इति
            इति
        इति
        पटम२ भवति वाअचच अङ्कः पभ अन्तः ।   ॰ LPATH[p] = ACC[v] + m
        पटम१ भवति पटम२ योगः पम ।   ॰ LPATH[p] = ACC[v] + m
        वालपअतह अङ्कः पप अन्तः भवति पटम१ ।   ॰ LPATH[p] = ACC[v] + m
        पटम१ भवति वालपअतह अङ्कः पप अन्तः ।   ॰ if LPATH[p] > w:
        यदि पटम१ अधिकम् पव आदि   ॰ if LPATH[p] > w:
            पव भवति वालपअतह अङ्कः पप अन्तः ।   ॰ w = LPATH[p]
        इति
        पप भवति पप वियोगः १ ।   ॰ p -= 1
    इति
    प्रत्यागमनम् पव ।   ॰ return w
इति

॰ fast_budget -> वृफअसतबउदगएत
वृत्तिः वृफअसतबउदगएत आदाय पह ॱॱ अ६४ ददाति अ६४ आदि
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ ३२ समाप्तम् ।   ॰ E.lget(LOC_TICKS)
    पटम१ भवति वालपअतह अङ्कः पह अन्तः ।   ॰ E.i64c(LPATH[h])
    व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पटम१ समाप्तम् ।   ॰ E.i64c(LPATH[h])
    व्यर्थम् भवति अक्षरलेखः वर्णाष्टकम् चघकङङक इति ।
    वाचतषनएसत भवति १ ।   ॰ CTXNEST = 1
    पटम१ भवति वाओरद अङ्कः पह अन्तः ।   ॰ to_safe(ORD[h])
    व्यर्थम् भवति वृतओसअफए पटम१ ।   ॰ to_safe(ORD[h])
    वाचतषनएसत भवति ० ।   ॰ CTXNEST = 0
    व्यर्थम् भवति एकलेखः ११ ।   ॰ E.o("end")
    प्रत्यागमनम् ० ।
इति

॰ pos_of_blk -> वृपओसओफबलक
वृत्तिः वृपओसओफबलक आदाय अवकाशः ॱॱ अ६४ ददाति अ६४ आदि
    व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ ४० समाप्तम् ।   ॰ E.lget(LOC_SAV)
    व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ २ समाप्तम् ।   ॰ E.i32c(2)
    व्यर्थम् भवति एकलेखः ११६ ।   ॰ E.o("i32.shl")
    व्यर्थम् भवति वस्मृतिः आरभ्य ४० ऽ २ ऽ वापओसअत समाप्तम् ।   ॰ E.mem("i32.load", POSAT)
    प्रत्यागमनम् ० ।
इति

॰ open_loop -> वृओपएनलओओप
वृत्तिः वृओपएनलओओप आदाय पह ॱॱ अ६४ ददाति अ६४ आदि
    चरः पख ॱॱ अ६४ भवति ० ।
    चरः पज ॱॱ अ६४ भवति ० ।
    चरः पष ॱॱ अ६४ भवति ० ।
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    चरः पटम३ ॱॱ अ६४ भवति ० ।
    चरः पटम४ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर१ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर२ ॱॱ अ६४ भवति ० ।
    व्यर्थम् भवति एकलेखः ३ ।   ॰ E.blk("loop")
    व्यर्थम् भवति एकलेखः ६४ ।   ॰ E.blk("loop")
    वाचउर भवति वाचउर योगः १ ।   ॰ CUR += 1
    वालओओपअत अङ्कः पह अन्तः भवति वाचउर ।   ॰ LOOPAT[h] = CUR
    पख भवति वालएनद अङ्कः पह अन्तः ।   ॰ q = LEND[h]
    यावत् पख अधिकम् पह आदि   ॰ while q > h:
        पटम१ भवति वृओवन पख ।   ॰ if own(q) == h:
        यदि पटम१ समम् पह आदि   ॰ if own(q) == h:
            व्यर्थम् भवति एकलेखः २ ।   ॰ E.blk("block")
            व्यर्थम् भवति एकलेखः ६४ ।   ॰ E.blk("block")
            वाचउर भवति वाचउर योगः १ ।   ॰ CUR += 1
            वालअब अङ्कः पख अन्तः भवति वाचउर ।   ॰ LAB[q] = CUR
        इति
        पख भवति पख वियोगः १ ।   ॰ q -= 1
    इति
    व्यर्थम् भवति एकलेखः २ ।   ॰ E.blk("block")
    व्यर्थम् भवति एकलेखः ६४ ।   ॰ E.blk("block")
    वाचउर भवति वाचउर योगः १ ।   ॰ CUR += 1
    वादलअब अङ्कः पह अन्तः भवति वाचउर ।   ॰ DLAB[h] = CUR
    पख भवति वालएनद अङ्कः पह अन्तः ।   ॰ q = LEND[h]
    यावत् पख अधिकम् पह आदि   ॰ while q > h:
        पटम१ भवति वालएनद अङ्कः पख अन्तः ।   ॰ if LEND[q] > q and LPAR[q] == h:
        पटम२ भवति ० ।   ॰ if LEND[q] > q and LPAR[q] == h:
        यदि पटम१ अधिकम् पख आदि   ॰ if LEND[q] > q and LPAR[q] == h:
            पटम२ भवति १ ।
        इति
        यदि पटम२ समम् १ आदि   ॰ if LEND[q] > q and LPAR[q] == h:
            पटम३ भवति वालपअर अङ्कः पख अन्तः ।   ॰ if LEND[q] > q and LPAR[q] == h:
            पटम४ भवति ० ।   ॰ if LEND[q] > q and LPAR[q] == h:
            यदि पटम३ समम् पह आदि   ॰ if LEND[q] > q and LPAR[q] == h:
                पटम४ भवति १ ।
            इति
            पटम२ भवति पटम४ ।
        इति
        यदि पटम२ समम् १ आदि   ॰ if LEND[q] > q and LPAR[q] == h:
            व्यर्थम् भवति एकलेखः २ ।   ॰ E.blk("block")
            व्यर्थम् भवति एकलेखः ६४ ।   ॰ E.blk("block")
            वाचउर भवति वाचउर योगः १ ।   ॰ CUR += 1
            वासलअब अङ्कः पख अन्तः भवति वाचउर ।   ॰ SLAB[q] = CUR
        इति
        पख भवति पख वियोगः १ ।   ॰ q -= 1
    इति
    व्यर्थम् भवति वक्रियाः आरभ्य ३५ ऽ ५६ समाप्तम् ।   ॰ E.gget(G_RT)
    व्यर्थम् भवति वक्रियाः आरभ्य ३४ ऽ ४० समाप्तम् ।   ॰ E.ltee(LOC_SAV)
    व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ ० समाप्तम् ।   ॰ E.i32c(0)
    व्यर्थम् भवति एकलेखः ७२ ।   ॰ E.o("i32.lt_s")
    पटम२ भवति वादलअब अङ्कः पह अन्तः ।   ॰ E.br_if(CUR - DLAB[h])
    पटम१ भवति वाचउर वियोगः पटम२ ।   ॰ E.br_if(CUR - DLAB[h])
    व्यर्थम् भवति वक्रियाः आरभ्य १३ ऽ पटम१ समाप्तम् ।   ॰ E.br_if(CUR - DLAB[h])
    व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ ऋण१ समाप्तम् ।   ॰ E.i32c(-1)
    व्यर्थम् भवति वक्रियाः आरभ्य ३६ ऽ ५६ समाप्तम् ।   ॰ E.gset(G_RT)
    व्यर्थम् भवति वृपओसओफबलक ० ।   ॰ pos_of_blk()
    व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ पह समाप्तम् ।   ॰ E.i32c(h)
    व्यर्थम् भवति एकलेखः १०७ ।   ॰ E.o("i32.sub")
    व्यर्थम् भवति एकलेखः १४ ।   ॰ E.byte(0x0E)
    पटम३ भवति वालएनद अङ्कः पह अन्तः ।   ॰ E.u(LEND[h] - h + 1)
    पटम२ भवति पटम३ वियोगः पह ।   ॰ E.u(LEND[h] - h + 1)
    पटम१ भवति पटम२ योगः १ ।   ॰ E.u(LEND[h] - h + 1)
    व्यर्थम् भवति वउलेबः पटम१ ।   ॰ E.u(LEND[h] - h + 1)
    पटम२ भवति वादलअब अङ्कः पह अन्तः ।   ॰ E.u(CUR - DLAB[h])
    पटम१ भवति वाचउर वियोगः पटम२ ।   ॰ E.u(CUR - DLAB[h])
    व्यर्थम् भवति वउलेबः पटम१ ।   ॰ E.u(CUR - DLAB[h])
    पटम१ भवति पह योगः १ ।   ॰ for j in range(h + 1, LEND[h] + 1):
    पज भवति पटम१ ।   ॰ for j in range(h + 1, LEND[h] + 1):
    पटम३ भवति वालएनद अङ्कः पह अन्तः ।   ॰ for j in range(h + 1, LEND[h] + 1):
    पटम२ भवति पटम३ योगः १ ।   ॰ for j in range(h + 1, LEND[h] + 1):
    पस्थिर१ भवति पटम२ ।   ॰ for j in range(h + 1, LEND[h] + 1):
    यावत् पज न्यूनम् पस्थिर१ आदि   ॰ for j in range(h + 1, LEND[h] + 1):
        पष भवति वृचहइलदओफ आरभ्य पह ऽ पज समाप्तम् ।   ॰ x = child_of(h, j)
        यदि पष समम् पज आदि   ॰ if x == j:
            पटम२ भवति वालअब अङ्कः पज अन्तः ।   ॰ E.u(CUR - LAB[j])
            पटम१ भवति वाचउर वियोगः पटम२ ।   ॰ E.u(CUR - LAB[j])
            व्यर्थम् भवति वउलेबः पटम१ ।   ॰ E.u(CUR - LAB[j])
        इति अन्यथा आदि
            पटम२ भवति वासलअब अङ्कः पष अन्तः ।   ॰ E.u(CUR - SLAB[x])
            पटम१ भवति वाचउर वियोगः पटम२ ।   ॰ E.u(CUR - SLAB[x])
            व्यर्थम् भवति वउलेबः पटम१ ।   ॰ E.u(CUR - SLAB[x])
        इति
        पज भवति पज योगः १ ।
    इति
    पटम२ भवति वादलअब अङ्कः पह अन्तः ।   ॰ E.u(CUR - DLAB[h])
    पटम१ भवति वाचउर वियोगः पटम२ ।   ॰ E.u(CUR - DLAB[h])
    व्यर्थम् भवति वउलेबः पटम१ ।   ॰ E.u(CUR - DLAB[h])
    पटम१ भवति पह योगः १ ।   ॰ for q in range(h + 1, LEND[h] + 1):
    पख भवति पटम१ ।   ॰ for q in range(h + 1, LEND[h] + 1):
    पटम३ भवति वालएनद अङ्कः पह अन्तः ।   ॰ for q in range(h + 1, LEND[h] + 1):
    पटम२ भवति पटम३ योगः १ ।   ॰ for q in range(h + 1, LEND[h] + 1):
    पस्थिर२ भवति पटम२ ।   ॰ for q in range(h + 1, LEND[h] + 1):
    यावत् पख न्यूनम् पस्थिर२ आदि   ॰ for q in range(h + 1, LEND[h] + 1):
        पटम१ भवति वालएनद अङ्कः पख अन्तः ।   ॰ if LEND[q] > q and LPAR[q] == h:
        पटम२ भवति ० ।   ॰ if LEND[q] > q and LPAR[q] == h:
        यदि पटम१ अधिकम् पख आदि   ॰ if LEND[q] > q and LPAR[q] == h:
            पटम२ भवति १ ।
        इति
        यदि पटम२ समम् १ आदि   ॰ if LEND[q] > q and LPAR[q] == h:
            पटम३ भवति वालपअर अङ्कः पख अन्तः ।   ॰ if LEND[q] > q and LPAR[q] == h:
            पटम४ भवति ० ।   ॰ if LEND[q] > q and LPAR[q] == h:
            यदि पटम३ समम् पह आदि   ॰ if LEND[q] > q and LPAR[q] == h:
                पटम४ भवति १ ।
            इति
            पटम२ भवति पटम४ ।
        इति
        यदि पटम२ समम् १ आदि   ॰ if LEND[q] > q and LPAR[q] == h:
            व्यर्थम् भवति एकलेखः ११ ।   ॰ E.o("end")
            वाचउर भवति वाचउर वियोगः १ ।   ॰ CUR -= 1
            व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ ४० समाप्तम् ।   ॰ E.lget(LOC_SAV)
            व्यर्थम् भवति वक्रियाः आरभ्य ३६ ऽ ५६ समाप्तम् ।   ॰ E.gset(G_RT)
            पटम२ भवति वालअब अङ्कः पख अन्तः ।   ॰ E.br(CUR - LAB[q])
            पटम१ भवति वाचउर वियोगः पटम२ ।   ॰ E.br(CUR - LAB[q])
            व्यर्थम् भवति वक्रियाः आरभ्य १२ ऽ पटम१ समाप्तम् ।   ॰ E.br(CUR - LAB[q])
        इति
        पख भवति पख योगः १ ।
    इति
    व्यर्थम् भवति एकलेखः ११ ।   ॰ E.o("end")
    वाचउर भवति वाचउर वियोगः १ ।   ॰ CUR -= 1
    व्यर्थम् भवति वृफअसतबउदगएत पह ।   ॰ fast_budget(h)
    प्रत्यागमनम् ० ।
इति

॰ pick_locals -> वृपइचकलओचअलस
वृत्तिः वृपइचकलओचअलस आदाय पअ ॱॱ अ६४ ऽ पब ॱॱ अ६४ ददाति अ६४ आदि
    चरः पर ॱॱ अ६४ भवति ० ।
    चरः पप ॱॱ अ६४ भवति ० ।
    चरः पइ ॱॱ अ६४ भवति ० ।
    चरः पभ ॱॱ अ६४ भवति ० ।
    चरः पव ॱॱ अ६४ भवति ० ।
    चरः पष ॱॱ अ६४ भवति ० ।
    चरः पद ॱॱ अ६४ भवति ० ।
    चरः पक ॱॱ अ६४ भवति ० ।
    चरः पबएसत ॱॱ अ६४ भवति ० ।
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    चरः पटम३ ॱॱ अ६४ भवति ० ।
    चरः पटम४ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर१ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर२ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर३ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर४ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर५ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर६ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर७ ॱॱ अ६४ भवति ० ।
    पर भवति ० ।   ॰ for r in range(32):
    पस्थिर१ भवति ३२ ।   ॰ for r in range(32):
    यावत् पर न्यूनम् पस्थिर१ आदि   ॰ for r in range(32):
        वाइनलओच अङ्कः पर अन्तः भवति १ ।   ॰ INLOC[r] = 1
        वारचनत अङ्कः पर अन्तः भवति ० ।   ॰ RCNT[r] = 0
        पर भवति पर योगः १ ।
    इति
    पटम१ भवति पब वियोगः पअ ।   ॰ if b - a > BIGSEG:
    यदि पटम१ अधिकम् ६०० आदि   ॰ if b - a > BIGSEG:
        पप भवति पअ ।   ॰ for p in range(a, b):
        पस्थिर२ भवति पब ।   ॰ for p in range(a, b):
        यावत् पप न्यूनम् पस्थिर२ आदि   ॰ for p in range(a, b):
            पभ भवति वाओरद अङ्कः पप अन्तः ।   ॰ v = ORD[p]
            पव भवति १ ।   ॰ w = 1
            पष भवति वाइननएर अङ्कः पप अन्तः ।   ॰ x = INNER[p]
            पद भवति ० ।   ॰ d = 0
            पस्थिर३ भवति १ ।   ॰ while x >= 0 and d < 6:
            यावत् पस्थिर३ समम् १ आदि   ॰ while x >= 0 and d < 6:
                पटम१ भवति ० ।   ॰ while x >= 0 and d < 6:
                यदि पष बृहत्समम् ० आदि   ॰ while x >= 0 and d < 6:
                    पटम१ भवति १ ।
                इति
                यदि पटम१ समम् १ आदि   ॰ while x >= 0 and d < 6:
                    पटम२ भवति ० ।   ॰ while x >= 0 and d < 6:
                    यदि पद न्यूनम् ६ आदि   ॰ while x >= 0 and d < 6:
                        पटम२ भवति १ ।
                    इति
                    पटम१ भवति पटम२ ।
                इति
                पस्थिर३ भवति ० ।
                यदि पटम१ समम् १ आदि
                    पस्थिर३ भवति १ ।
                इति
                यदि पस्थिर३ समम् १ आदि
                    पव भवति पव गुणनम् ८ ।   ॰ w = w * 8
                    पद भवति पद योगः १ ।   ॰ d += 1
                    पष भवति वालपअर अङ्कः पष अन्तः ।   ॰ x = LPAR[x]
                इति
            इति
            पटम१ भवति वासतअरतस अङ्कः पभ अन्तः ।   ॰ for k in range(STARTS[v], STARTS[v] + BLEN[v]):
            पक भवति पटम१ ।   ॰ for k in range(STARTS[v], STARTS[v] + BLEN[v]):
            पटम३ भवति वासतअरतस अङ्कः पभ अन्तः ।   ॰ for k in range(STARTS[v], STARTS[v] + BLEN[v]):
            पटम४ भवति वाबलएन अङ्कः पभ अन्तः ।   ॰ for k in range(STARTS[v], STARTS[v] + BLEN[v]):
            पटम२ भवति पटम३ योगः पटम४ ।   ॰ for k in range(STARTS[v], STARTS[v] + BLEN[v]):
            पस्थिर४ भवति पटम२ ।   ॰ for k in range(STARTS[v], STARTS[v] + BLEN[v]):
            यावत् पक न्यूनम् पस्थिर४ आदि   ॰ for k in range(STARTS[v], STARTS[v] + BLEN[v]):
                पटम१ भवति लक्ष्याणि अङ्कः पक अन्तः ।   ॰ RCNT[RD[k]] += w
                पटम४ भवति लक्ष्याणि अङ्कः पक अन्तः ।   ॰ RCNT[RD[k]] += w
                पटम३ भवति वारचनत अङ्कः पटम४ अन्तः ।   ॰ RCNT[RD[k]] += w
                पटम२ भवति पटम३ योगः पव ।   ॰ RCNT[RD[k]] += w
                वारचनत अङ्कः पटम१ अन्तः भवति पटम२ ।   ॰ RCNT[RD[k]] += w
