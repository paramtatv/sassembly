    पटम२ भवति पटम३ योगः १५ ।   ॰ POSAT = (SEGOFAT + 2 * NBLK + 15) // 16 * 16
    पटम१ भवति पटम२ विभाजनम् १६ ।   ॰ POSAT = (SEGOFAT + 2 * NBLK + 15) // 16 * 16
    वापओसअत भवति पटम१ गुणनम् १६ ।   ॰ POSAT = (SEGOFAT + 2 * NBLK + 15) // 16 * 16
    पटम४ भवति ४ गुणनम् वानबलक ।   ॰ XRAT = (POSAT + 4 * NBLK + 15) // 16 * 16
    पटम३ भवति वापओसअत योगः पटम४ ।   ॰ XRAT = (POSAT + 4 * NBLK + 15) // 16 * 16
    पटम२ भवति पटम३ योगः १५ ।   ॰ XRAT = (POSAT + 4 * NBLK + 15) // 16 * 16
    पटम१ भवति पटम२ विभाजनम् १६ ।   ॰ XRAT = (POSAT + 4 * NBLK + 15) // 16 * 16
    वाषरअत भवति पटम१ गुणनम् १६ ।   ॰ XRAT = (POSAT + 4 * NBLK + 15) // 16 * 16
    पटम३ भवति वाषरअत योगः २५६ ।   ॰ RAMOFF = (XRAT + 256 + 0xFFFF) // 0x10000 * 0x10000
    पटम२ भवति पटम३ योगः ६५५३५ ।   ॰ RAMOFF = (XRAT + 256 + 0xFFFF) // 0x10000 * 0x10000
    पटम१ भवति पटम२ विभाजनम् ६५५३६ ।   ॰ RAMOFF = (XRAT + 256 + 0xFFFF) // 0x10000 * 0x10000
    वारअमओफफ भवति पटम१ गुणनम् ६५५३६ ।   ॰ RAMOFF = (XRAT + 256 + 0xFFFF) // 0x10000 * 0x10000
    प्रत्यागमनम् ० ।
इति

॰ rget -> वृरगएत
वृत्तिः वृरगएत आदाय पन ॱॱ अ६४ ददाति अ६४ आदि
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    चरः पटम३ ॱॱ अ६४ भवति ० ।
    यदि पन समम् ० आदि   ॰ if n == 0:
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ ० समाप्तम् ।   ॰ E.i64c(0)
    इति अन्यथा आदि
        पटम१ भवति ० ।   ॰ elif FASTM and INLOC[n] == 0:
        यदि वाफअसतम असमम् ० आदि   ॰ elif FASTM and INLOC[n] == 0:
            पटम१ भवति १ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ elif FASTM and INLOC[n] == 0:
            पटम२ भवति वाइनलओच अङ्कः पन अन्तः ।   ॰ elif FASTM and INLOC[n] == 0:
            पटम३ भवति ० ।   ॰ elif FASTM and INLOC[n] == 0:
            यदि पटम२ समम् ० आदि   ॰ elif FASTM and INLOC[n] == 0:
                पटम३ भवति १ ।
            इति
            पटम१ भवति पटम३ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ elif FASTM and INLOC[n] == 0:
            व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ ० समाप्तम् ।   ॰ E.i32c(0)
            पटम२ भवति ८ गुणनम् पन ।   ॰ E.mem("i64.load", XRAT + 8 * n)
            पटम१ भवति वाषरअत योगः पटम२ ।   ॰ E.mem("i64.load", XRAT + 8 * n)
            व्यर्थम् भवति वस्मृतिः आरभ्य ४१ ऽ ३ ऽ पटम१ समाप्तम् ।   ॰ E.mem("i64.load", XRAT + 8 * n)
        इति अन्यथा आदि
            पटम१ भवति पन वियोगः १ ।   ॰ E.lget(n - 1)
            व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ पटम१ समाप्तम् ।   ॰ E.lget(n - 1)
        इति
    इति
    प्रत्यागमनम् ० ।
इति

॰ rput -> वृरपउत
वृत्तिः वृरपउत आदाय पन ॱॱ अ६४ ददाति अ६४ आदि
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    चरः पटम३ ॱॱ अ६४ भवति ० ।
    पटम१ भवति ० ।   ॰ if n:
    यदि पन असमम् ० आदि   ॰ if n:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if n:
        पटम१ भवति ० ।   ॰ if FASTM:
        यदि वाफअसतम असमम् ० आदि   ॰ if FASTM:
            पटम१ भवति १ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if FASTM:
            पटम२ भवति वारएगभएर अङ्कः पन अन्तः ।   ॰ REGVER[n] += 1
            पटम१ भवति पटम२ योगः १ ।   ॰ REGVER[n] += 1
            वारएगभएर अङ्कः पन अन्तः भवति पटम१ ।   ॰ REGVER[n] += 1
        इति
        पटम१ भवति ० ।   ॰ if FASTM and n == 2:
        यदि वाफअसतम असमम् ० आदि   ॰ if FASTM and n == 2:
            पटम१ भवति १ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if FASTM and n == 2:
            पटम२ भवति ० ।   ॰ if FASTM and n == 2:
            यदि पन समम् २ आदि   ॰ if FASTM and n == 2:
                पटम२ भवति १ ।
            इति
            पटम१ भवति पटम२ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if FASTM and n == 2:
            व्यर्थम् भवति वक्रियाः आरभ्य ३४ ऽ १ समाप्तम् ।   ॰ E.ltee(1)
            व्यर्थम् भवति एकलेखः १६७ ।   ॰ E.o("i32.wrap_i64")
            व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ ऋण२१४७४८३६४८ समाप्तम् ।   ॰ E.i32c(-2147483648)
            व्यर्थम् भवति एकलेखः १०६ ।   ॰ E.o("i32.add")
            व्यर्थम् भवति वक्रियाः आरभ्य ३३ ऽ ४१ समाप्तम् ।   ॰ E.lset(LOC_SPA)
        इति अन्यथा आदि
            पटम१ भवति ० ।   ॰ elif FASTM and INLOC[n] == 0:
            यदि वाफअसतम असमम् ० आदि   ॰ elif FASTM and INLOC[n] == 0:
                पटम१ भवति १ ।
            इति
            यदि पटम१ समम् १ आदि   ॰ elif FASTM and INLOC[n] == 0:
                पटम२ भवति वाइनलओच अङ्कः पन अन्तः ।   ॰ elif FASTM and INLOC[n] == 0:
                पटम३ भवति ० ।   ॰ elif FASTM and INLOC[n] == 0:
                यदि पटम२ समम् ० आदि   ॰ elif FASTM and INLOC[n] == 0:
                    पटम३ भवति १ ।
                इति
                पटम१ भवति पटम३ ।
            इति
            यदि पटम१ समम् १ आदि   ॰ elif FASTM and INLOC[n] == 0:
                व्यर्थम् भवति वक्रियाः आरभ्य ३३ ऽ ३३ समाप्तम् ।   ॰ E.lset(LOC_EA)
                व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ ० समाप्तम् ।   ॰ E.i32c(0)
                व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ ३३ समाप्तम् ।   ॰ E.lget(LOC_EA)
                पटम२ भवति ८ गुणनम् पन ।   ॰ E.mem("i64.store", XRAT + 8 * n)
                पटम१ भवति वाषरअत योगः पटम२ ।   ॰ E.mem("i64.store", XRAT + 8 * n)
                व्यर्थम् भवति वस्मृतिः आरभ्य ५५ ऽ ३ ऽ पटम१ समाप्तम् ।   ॰ E.mem("i64.store", XRAT + 8 * n)
            इति अन्यथा आदि
                पटम१ भवति पन वियोगः १ ।   ॰ E.lset(n - 1)
                व्यर्थम् भवति वक्रियाः आरभ्य ३३ ऽ पटम१ समाप्तम् ।   ॰ E.lset(n - 1)
            इति
        इति
    इति अन्यथा आदि
        व्यर्थम् भवति एकलेखः २६ ।   ॰ E.o("drop")
    इति
    प्रत्यागमनम् ० ।
इति

॰ fault -> वृफअउलत
वृत्तिः वृफअउलत आदाय पकइनद ॱॱ अ६४ ऽ पपच ॱॱ अ६४ ऽ पअलओच ॱॱ अ६४ ऽ पअभअल ॱॱ अ६४ ऽ पभलओच ॱॱ अ६४ ऽ पभभअल ॱॱ अ६४ ऽ परएफउनद ॱॱ अ६४ ददाति अ६४ आदि
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    यदि पकइनद न्यूनम् ० आदि   ॰ if kind < 0:
        व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ ३९ समाप्तम् ।   ॰ E.lget(LOC_K)
    इति अन्यथा आदि
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ पकइनद समाप्तम् ।   ॰ E.i32c(kind)
    इति
    व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पपच समाप्तम् ।   ॰ E.i64c(pc)
    पटम१ भवति ० ।   ॰ if aloc:
    यदि पअलओच असमम् ० आदि   ॰ if aloc:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if aloc:
        व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ पअभअल समाप्तम् ।   ॰ E.lget(aval)
    इति अन्यथा आदि
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पअभअल समाप्तम् ।   ॰ E.i64c(aval)
    इति
    पटम१ भवति ० ।   ॰ if vloc:
    यदि पभलओच असमम् ० आदि   ॰ if vloc:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if vloc:
        व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ पभभअल समाप्तम् ।   ॰ E.lget(vval)
    इति अन्यथा आदि
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पभभअल समाप्तम् ।   ॰ E.i64c(vval)
    इति
    व्यर्थम् भवति वक्रियाः आरभ्य १६ ऽ ४ समाप्तम् ।   ॰ E.call(F_HALT)
    पटम१ भवति ० ।   ॰ if refund and ATTEST == 0:
    यदि परएफउनद असमम् ० आदि   ॰ if refund and ATTEST == 0:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if refund and ATTEST == 0:
        पटम२ भवति ० ।   ॰ if refund and ATTEST == 0:
        यदि वाअततएसत समम् ० आदि   ॰ if refund and ATTEST == 0:
            पटम२ भवति १ ।
        इति
        पटम१ भवति पटम२ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if refund and ATTEST == 0:
        व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ ३२ समाप्तम् ।   ॰ E.lget(LOC_TICKS)
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ परएफउनद समाप्तम् ।   ॰ E.i64c(refund)
        व्यर्थम् भवति एकलेखः १२४ ।   ॰ E.o("i64.add")
        व्यर्थम् भवति वक्रियाः आरभ्य ३३ ऽ ३२ समाप्तम् ।   ॰ E.lset(LOC_TICKS)
    इति
    पटम१ भवति वाचतषचनत योगः वाचतषनएसत ।   ॰ E.br(CTXCNT + CTXNEST)
    व्यर्थम् भवति वक्रियाः आरभ्य १२ ऽ पटम१ समाप्तम् ।   ॰ E.br(CTXCNT + CTXNEST)
    प्रत्यागमनम् ० ।
इति

॰ contains -> वृचओनतअइनस
वृत्तिः वृचओनतअइनस आदाय पह ॱॱ अ६४ ऽ पइ ॱॱ अ६४ ददाति अ६४ आदि
    चरः पर ॱॱ अ६४ भवति ० ।
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    चरः पटम३ ॱॱ अ६४ भवति ० ।
    पर भवति ० ।   ॰ r = 0
    यदि पह न्यूनम् ० आदि   ॰ if h < 0:
        पर भवति १ ।   ॰ r = 1
    इति अन्यथा आदि
        पटम१ भवति ० ।   ॰ elif h <= i and i <= LEND[h]:
        यदि पइ बृहत्समम् पह आदि   ॰ elif h <= i and i <= LEND[h]:
            पटम१ भवति १ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ elif h <= i and i <= LEND[h]:
            पटम२ भवति वालएनद अङ्कः पह अन्तः ।   ॰ elif h <= i and i <= LEND[h]:
            पटम३ भवति ० ।   ॰ elif h <= i and i <= LEND[h]:
            यदि पटम२ बृहत्समम् पइ आदि   ॰ elif h <= i and i <= LEND[h]:
                पटम३ भवति १ ।
            इति
            पटम१ भवति पटम३ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ elif h <= i and i <= LEND[h]:
            पर भवति १ ।   ॰ r = 1
        इति
    इति
    प्रत्यागमनम् पर ।   ॰ return r
इति

॰ own -> वृओवन
वृत्तिः वृओवन आदाय पप ॱॱ अ६४ ददाति अ६४ आदि
    चरः पर ॱॱ अ६४ भवति ० ।
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    पर भवति वाइननएर अङ्कः पप अन्तः ।   ॰ r = INNER[p]
    पटम१ भवति वालएनद अङ्कः पप अन्तः ।   ॰ if LEND[p] >= 0:
    यदि पटम१ बृहत्समम् ० आदि   ॰ if LEND[p] >= 0:
        पर भवति वालपअर अङ्कः पप अन्तः ।   ॰ r = LPAR[p]
    इति
    प्रत्यागमनम् पर ।   ॰ return r
इति

॰ direct_target -> वृदइरएचततअरगएत
वृत्तिः वृदइरएचततअरगएत आदाय पपच ॱॱ अ६४ ऽ पइमम ॱॱ अ६४ ददाति अ६४ आदि
    चरः पत ॱॱ अ६४ भवति ० ।
    चरः पर ॱॱ अ६४ भवति ० ।
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    चरः पटम३ ॱॱ अ६४ भवति ० ।
    चरः पटम४ ॱॱ अ६४ भवति ० ।
    चरः पटम५ ॱॱ अ६४ भवति ० ।
    चरः पटम६ ॱॱ अ६४ भवति ० ।
    पत भवति पपच योगः पइमम ।   ॰ t = pc + imm
    पर भवति ऋण१ ।   ॰ r = -1
    पटम१ भवति ० ।   ॰ if t >= WG_BASE and t < WG_BASE + 4 * NWORDS and t % 4 == 0:
    यदि पत बृहत्समम् वावगबअसए आदि   ॰ if t >= WG_BASE and t < WG_BASE + 4 * NWORDS and t % 4 == 0:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if t >= WG_BASE and t < WG_BASE + 4 * NWORDS and t % 4 == 0:
        पटम३ भवति ४ गुणनम् शब्दगणना ।   ॰ if t >= WG_BASE and t < WG_BASE + 4 * NWORDS and t % 4 == 0:
        पटम२ भवति वावगबअसए योगः पटम३ ।   ॰ if t >= WG_BASE and t < WG_BASE + 4 * NWORDS and t % 4 == 0:
        पटम४ भवति ० ।   ॰ if t >= WG_BASE and t < WG_BASE + 4 * NWORDS and t % 4 == 0:
        यदि पत न्यूनम् पटम२ आदि   ॰ if t >= WG_BASE and t < WG_BASE + 4 * NWORDS and t % 4 == 0:
            पटम४ भवति १ ।
        इति
        पटम१ भवति पटम४ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if t >= WG_BASE and t < WG_BASE + 4 * NWORDS and t % 4 == 0:
        पटम५ भवति पत शेषः ४ ।   ॰ if t >= WG_BASE and t < WG_BASE + 4 * NWORDS and t % 4 == 0:
        पटम६ भवति ० ।   ॰ if t >= WG_BASE and t < WG_BASE + 4 * NWORDS and t % 4 == 0:
        यदि पटम५ समम् ० आदि   ॰ if t >= WG_BASE and t < WG_BASE + 4 * NWORDS and t % 4 == 0:
            पटम६ भवति १ ।
        इति
        पटम१ भवति पटम६ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if t >= WG_BASE and t < WG_BASE + 4 * NWORDS and t % 4 == 0:
        पटम२ भवति पत वियोगः वावगबअसए ।   ॰ r = BLKOF[(t - WG_BASE) // 4]
        पटम१ भवति पटम२ विभाजनम् ४ ।   ॰ r = BLKOF[(t - WG_BASE) // 4]
        पर भवति वाबलकओफ अङ्कः पटम१ अन्तः ।   ॰ r = BLKOF[(t - WG_BASE) // 4]
    इति
    प्रत्यागमनम् पर ।   ॰ return r
इति

॰ thread -> वृतहरएअद
वृत्तिः वृतहरएअद आदाय पत ॱॱ अ६४ ददाति अ६४ आदि
    चरः पन ॱॱ अ६४ भवति ० ।
    चरः पक ॱॱ अ६४ भवति ० ।
    चरः पउ ॱॱ अ६४ भवति ० ।
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    चरः पटम३ ॱॱ अ६४ भवति ० ।
    चरः पटम४ ॱॱ अ६४ भवति ० ।
    चरः पटम५ ॱॱ अ६४ भवति ० ।
    चरः पटम६ ॱॱ अ६४ भवति ० ।
    चरः पटम७ ॱॱ अ६४ भवति ० ।
    चरः पटम८ ॱॱ अ६४ भवति ० ।
    चरः पटम९ ॱॱ अ६४ भवति ० ।
    चरः पटम१० ॱॱ अ६४ भवति ० ।
    चरः पटम११ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर१ ॱॱ अ६४ भवति ० ।
    वातहरएअदष भवति ० ।   ॰ THREADX = 0
    पन भवति ० ।   ॰ n = 0
    पस्थिर१ भवति १ ।   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
    यावत् पस्थिर१ समम् १ आदि   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
        पटम१ भवति ० ।   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
        यदि पन न्यूनम् ८ आदि   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
            पटम१ भवति १ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
            पटम२ भवति ० ।   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
            यदि पत बृहत्समम् वासएगलओ आदि   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
                पटम२ भवति १ ।
            इति
            पटम१ भवति पटम२ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
            पटम३ भवति ० ।   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
            यदि पत न्यूनम् वासएगहइ आदि   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
                पटम३ भवति १ ।
            इति
            पटम१ भवति पटम३ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
            पटम४ भवति वाबलएन अङ्कः पत अन्तः ।   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
            पटम५ भवति ० ।   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
            यदि पटम४ समम् १ आदि   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
                पटम५ भवति १ ।
            इति
            पटम१ भवति पटम५ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
            पटम७ भवति वासतअरतस अङ्कः पत अन्तः ।   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
            पटम६ भवति क्रियाः अङ्कः पटम७ अन्तः ।   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
            पटम८ भवति ० ।   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
            यदि पटम६ समम् ३ आदि   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
                पटम८ भवति १ ।
            इति
            पटम१ भवति पटम८ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
            पटम१० भवति वासतअरतस अङ्कः पत अन्तः ।   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
            पटम९ भवति लक्ष्याणि अङ्कः पटम१० अन्तः ।   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
            पटम११ भवति ० ।   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
            यदि पटम९ समम् ० आदि   ॰ while n < 8 and t >= SEGLO and t < SEGHI and BLEN[t] == 1 and OPS[STAR
                पटम११ भवति १ ।
            इति
            पटम१ भवति पटम११ ।
        इति
        पस्थिर१ भवति ० ।
        यदि पटम१ समम् १ आदि
            पस्थिर१ भवति १ ।
        इति
        यदि पस्थिर१ समम् १ आदि
            पक भवति वासतअरतस अङ्कः पत अन्तः ।   ॰ k = STARTS[t]
            पटम२ भवति ४ गुणनम् पक ।   ॰ u = direct_target(WG_BASE + 4 * k, IMM[k])
            पटम१ भवति वावगबअसए योगः पटम२ ।   ॰ u = direct_target(WG_BASE + 4 * k, IMM[k])
            पटम३ भवति मात्राः अङ्कः पक अन्तः ।   ॰ u = direct_target(WG_BASE + 4 * k, IMM[k])
            पउ भवति वृदइरएचततअरगएत आरभ्य पटम१ ऽ पटम३ समाप्तम् ।   ॰ u = direct_target(WG_BASE + 4 * k, IMM[k])
            पन भवति पन योगः १ ।   ॰ n += 1
            पटम१ भवति ० ।   ॰ if u < 0 or u == t:
            यदि पउ न्यूनम् ० आदि   ॰ if u < 0 or u == t:
                पटम१ भवति १ ।
            इति
            यदि पटम१ समम् ० आदि   ॰ if u < 0 or u == t:
                पटम२ भवति ० ।   ॰ if u < 0 or u == t:
                यदि पउ समम् पत आदि   ॰ if u < 0 or u == t:
                    पटम२ भवति १ ।
                इति
                पटम१ भवति पटम२ ।
            इति
            यदि पटम१ समम् १ आदि   ॰ if u < 0 or u == t:
                पन भवति ८ ।   ॰ n = 8
            इति अन्यथा आदि
                पटम१ भवति वाअचच अङ्कः पत अन्तः ।   ॰ THREADX += ACC[t]
                वातहरएअदष भवति वातहरएअदष योगः पटम१ ।   ॰ THREADX += ACC[t]
                पत भवति पउ ।   ॰ t = u
            इति
        इति
    इति
    प्रत्यागमनम् पत ।   ॰ return t
इति

॰ fast_goto -> वृफअसतगओतओ
वृत्तिः वृफअसतगओतओ आदाय पत ॱॱ अ६४ ददाति अ६४ आदि
    चरः पइ ॱॱ अ६४ भवति ० ।
    चरः पतप ॱॱ अ६४ भवति ० ।
    चरः पष ॱॱ अ६४ भवति ० ।
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    चरः पटम३ ॱॱ अ६४ भवति ० ।
    चरः पटम४ ॱॱ अ६४ भवति ० ।
    चरः पटम५ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर१ ॱॱ अ६४ भवति ० ।
    पइ भवति वाचउरबलक ।   ॰ i = CURBLK
    पत भवति वृतहरएअद पत ।   ॰ t = thread(t)
    यदि वातहरएअदष अधिकम् ० आदि   ॰ if THREADX > 0:
        व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ ३२ समाप्तम् ।   ॰ E.lget(LOC_TICKS)
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ वातहरएअदष समाप्तम् ।   ॰ E.i64c(THREADX)
        व्यर्थम् भवति एकलेखः १२५ ।   ॰ E.o("i64.sub")
        व्यर्थम् भवति वक्रियाः आरभ्य ३३ ऽ ३२ समाप्तम् ।   ॰ E.lset(LOC_TICKS)
    इति
    पटम१ भवति ० ।   ॰ if t < SEGLO or t >= SEGHI:
    यदि पत न्यूनम् वासएगलओ आदि   ॰ if t < SEGLO or t >= SEGHI:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् ० आदि   ॰ if t < SEGLO or t >= SEGHI:
        पटम२ भवति ० ।   ॰ if t < SEGLO or t >= SEGHI:
        यदि पत बृहत्समम् वासएगहइ आदि   ॰ if t < SEGLO or t >= SEGHI:
            पटम२ भवति १ ।
        इति
        पटम१ भवति पटम२ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if t < SEGLO or t >= SEGHI:
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ पत समाप्तम् ।   ॰ E.i32c(t)
        व्यर्थम् भवति वक्रियाः आरभ्य ३६ ऽ ३३ समाप्तम् ।   ॰ E.gset(G_BLK)
        पटम२ भवति वाचउर योगः वाचतषनएसत ।   ॰ E.br(CUR + CTXNEST - EXITAT)
        पटम१ भवति पटम२ वियोगः वाएषइतअत ।   ॰ E.br(CUR + CTXNEST - EXITAT)
        व्यर्थम् भवति वक्रियाः आरभ्य १२ ऽ पटम१ समाप्तम् ।   ॰ E.br(CUR + CTXNEST - EXITAT)
    इति अन्यथा आदि
        पतप भवति वापओस अङ्कः पत अन्तः ।   ॰ tp = POS[t]
        पटम१ भवति ० ।   ॰ if tp <= i and LEND[tp] >= i:
        यदि पइ बृहत्समम् पतप आदि   ॰ if tp <= i and LEND[tp] >= i:
            पटम१ भवति १ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if tp <= i and LEND[tp] >= i:
            पटम२ भवति वालएनद अङ्कः पतप अन्तः ।   ॰ if tp <= i and LEND[tp] >= i:
            पटम३ भवति ० ।   ॰ if tp <= i and LEND[tp] >= i:
            यदि पटम२ बृहत्समम् पइ आदि   ॰ if tp <= i and LEND[tp] >= i:
                पटम३ भवति १ ।
            इति
            पटम१ भवति पटम३ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if tp <= i and LEND[tp] >= i:
            पटम२ भवति वाचउर योगः वाचतषनएसत ।   ॰ E.br(CUR + CTXNEST - LOOPAT[tp])
            पटम३ भवति वालओओपअत अङ्कः पतप अन्तः ।   ॰ E.br(CUR + CTXNEST - LOOPAT[tp])
            पटम१ भवति पटम२ वियोगः पटम३ ।   ॰ E.br(CUR + CTXNEST - LOOPAT[tp])
            व्यर्थम् भवति वक्रियाः आरभ्य १२ ऽ पटम१ समाप्तम् ।   ॰ E.br(CUR + CTXNEST - LOOPAT[tp])
        इति अन्यथा आदि
            यदि पइ बृहत्समम् पतप आदि   ॰ elif tp <= i:
                व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ पत समाप्तम् ।   ॰ E.i32c(t)
                व्यर्थम् भवति वक्रियाः आरभ्य ३३ ऽ ३७ समाप्तम् ।   ॰ E.lset(LOC_BLK)
                पटम२ भवति वाचउर योगः वाचतषनएसत ।   ॰ E.br(CUR + CTXNEST - TOPAT)
                पटम१ भवति पटम२ वियोगः वातओपअत ।   ॰ E.br(CUR + CTXNEST - TOPAT)
                व्यर्थम् भवति वक्रियाः आरभ्य १२ ऽ पटम१ समाप्तम् ।   ॰ E.br(CUR + CTXNEST - TOPAT)
            इति अन्यथा आदि
                पटम२ भवति वृओवन पतप ।   ॰ elif contains(own(tp), i):
                पटम१ भवति वृचओनतअइनस आरभ्य पटम२ ऽ पइ समाप्तम् ।   ॰ elif contains(own(tp), i):
                पटम३ भवति ० ।   ॰ elif contains(own(tp), i):
                यदि पटम१ असमम् ० आदि   ॰ elif contains(own(tp), i):
                    पटम३ भवति १ ।
                इति
                यदि पटम३ समम् १ आदि   ॰ elif contains(own(tp), i):
                    पटम२ भवति वाचउर योगः वाचतषनएसत ।   ॰ E.br(CUR + CTXNEST - LAB[tp])
                    पटम३ भवति वालअब अङ्कः पतप अन्तः ।   ॰ E.br(CUR + CTXNEST - LAB[tp])
                    पटम१ भवति पटम२ वियोगः पटम३ ।   ॰ E.br(CUR + CTXNEST - LAB[tp])
                    व्यर्थम् भवति वक्रियाः आरभ्य १२ ऽ पटम१ समाप्तम् ।   ॰ E.br(CUR + CTXNEST - LAB[tp])
                इति अन्यथा आदि
                    पष भवति पतप ।   ॰ x = tp
                    पटम१ भवति वालएनद अङ्कः पतप अन्तः ।   ॰ if LEND[tp] < 0:
                    यदि पटम१ न्यूनम् ० आदि   ॰ if LEND[tp] < 0:
                        पष भवति वाइननएर अङ्कः पतप अन्तः ।   ॰ x = INNER[tp]
                    इति
                    पस्थिर१ भवति १ ।   ॰ while LPAR[x] >= 0 and contains(LPAR[x], i) == 0:
                    यावत् पस्थिर१ समम् १ आदि   ॰ while LPAR[x] >= 0 and contains(LPAR[x], i) == 0:
                        पटम१ भवति वालपअर अङ्कः पष अन्तः ।   ॰ while LPAR[x] >= 0 and contains(LPAR[x], i) == 0:
                        पटम२ भवति ० ।   ॰ while LPAR[x] >= 0 and contains(LPAR[x], i) == 0:
                        यदि पटम१ बृहत्समम् ० आदि   ॰ while LPAR[x] >= 0 and contains(LPAR[x], i) == 0:
                            पटम२ भवति १ ।
                        इति
                        यदि पटम२ समम् १ आदि   ॰ while LPAR[x] >= 0 and contains(LPAR[x], i) == 0:
                            पटम४ भवति वालपअर अङ्कः पष अन्तः ।   ॰ while LPAR[x] >= 0 and contains(LPAR[x], i) == 0:
                            पटम३ भवति वृचओनतअइनस आरभ्य पटम४ ऽ पइ समाप्तम् ।   ॰ while LPAR[x] >= 0 and contains(LPAR[x], i) == 0:
                            पटम५ भवति ० ।   ॰ while LPAR[x] >= 0 and contains(LPAR[x], i) == 0:
                            यदि पटम३ समम् ० आदि   ॰ while LPAR[x] >= 0 and contains(LPAR[x], i) == 0:
                                पटम५ भवति १ ।
                            इति
                            पटम२ भवति पटम५ ।
                        इति
                        पस्थिर१ भवति ० ।
                        यदि पटम२ समम् १ आदि
                            पस्थिर१ भवति १ ।
                        इति
                        यदि पस्थिर१ समम् १ आदि
                            पष भवति वालपअर अङ्कः पष अन्तः ।   ॰ x = LPAR[x]
                        इति
                    इति
                    व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ पत समाप्तम् ।   ॰ E.i32c(t)
                    व्यर्थम् भवति वक्रियाः आरभ्य ३६ ऽ ५६ समाप्तम् ।   ॰ E.gset(G_RT)
                    पटम२ भवति वाचउर योगः वाचतषनएसत ।   ॰ E.br(CUR + CTXNEST - LAB[x])
                    पटम३ भवति वालअब अङ्कः पष अन्तः ।   ॰ E.br(CUR + CTXNEST - LAB[x])
                    पटम१ भवति पटम२ वियोगः पटम३ ।   ॰ E.br(CUR + CTXNEST - LAB[x])
                    व्यर्थम् भवति वक्रियाः आरभ्य १२ ऽ पटम१ समाप्तम् ।   ॰ E.br(CUR + CTXNEST - LAB[x])
                इति
            इति
        इति
    इति
    प्रत्यागमनम् ० ।
इति

॰ goto_blk -> वृगओतओबलक
वृत्तिः वृगओतओबलक आदाय पबइ ॱॱ अ६४ ददाति अ६४ आदि
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    पटम१ भवति ० ।   ॰ if FASTM:
    यदि वाफअसतम असमम् ० आदि   ॰ if FASTM:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if FASTM:
        व्यर्थम् भवति वृफअसतगओतओ पबइ ।   ॰ fast_goto(bi)
    इति अन्यथा आदि
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ पबइ समाप्तम् ।   ॰ E.i32c(bi)
        व्यर्थम् भवति वक्रियाः आरभ्य ३३ ऽ ३७ समाप्तम् ।   ॰ E.lset(LOC_BLK)
        पटम२ भवति वाचतषचनत योगः वाचतषनएसत ।   ॰ E.br(CTXCNT + CTXNEST + 2)
        पटम१ भवति पटम२ योगः २ ।   ॰ E.br(CTXCNT + CTXNEST + 2)
        व्यर्थम् भवति वक्रियाः आरभ्य १२ ऽ पटम१ समाप्तम् ।   ॰ E.br(CTXCNT + CTXNEST + 2)
    इति
    प्रत्यागमनम् ० ।
इति

॰ win_test -> वृवइनतएसत
वृत्तिः वृवइनतएसत आदाय अवकाशः ॱॱ अ६४ ददाति अ६४ आदि
    चरः पटम१ ॱॱ अ६४ भवति ० ।
