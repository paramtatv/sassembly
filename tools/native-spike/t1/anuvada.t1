इति

॰ wasm_module -> वृवअसममओदउलए
वृत्तिः वृवअसममओदउलए आदाय पअततएसत ॱॱ अ६४ ददाति अ६४ आदि
    चरः पनफ ॱॱ अ६४ भवति ० ।
    चरः पपओस ॱॱ अ६४ भवति ० ।
    चरः पइ ॱॱ अ६४ भवति ० ।
    चरः पप२ ॱॱ अ६४ भवति ० ।
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    चरः पटम३ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर१ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर२ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर३ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर४ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर५ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर६ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर७ ॱॱ अ६४ भवति ० ।
    व्यर्थम् भवति अक्षरलेखः वर्णाष्टकम् ककछखजघछढकखकककककक इति ।
    व्यर्थम् भवति वृसएचतयपएस ० ।   ॰ sec_types()
    व्यर्थम् भवति वृसएचइमपओरतस ० ।   ॰ sec_imports()
    पनफ भवति वानसएग ।   ॰ nf = NSEG
    यदि पअततएसत समम् ० आदि   ॰ if attest == 0:
        पनफ भवति २ गुणनम् वानसएग ।   ॰ nf = 2 * NSEG
    इति
    पपओस भवति वृसएचबएगइन ३ ।   ॰ pos = sec_begin(3)
    पटम१ भवति १६ योगः पनफ ।   ॰ E.u(16 + nf)
    व्यर्थम् भवति वउलेबः पटम१ ।   ॰ E.u(16 + nf)
    पइ भवति ३ ।   ॰ for i in range(F_FLUSH, F_LEFT + 1):
    पस्थिर१ भवति १९ ।   ॰ for i in range(F_FLUSH, F_LEFT + 1):
    यावत् पइ न्यूनम् पस्थिर१ आदि   ॰ for i in range(F_FLUSH, F_LEFT + 1):
        पटम१ भवति वृहतयपए पइ ।   ॰ E.u(h_type(i))
        व्यर्थम् भवति वउलेबः पटम१ ।   ॰ E.u(h_type(i))
        पइ भवति पइ योगः १ ।
    इति
    पइ भवति ० ।   ॰ for i in range(nf):
    पस्थिर२ भवति पनफ ।   ॰ for i in range(nf):
    यावत् पइ न्यूनम् पस्थिर२ आदि   ॰ for i in range(nf):
        व्यर्थम् भवति वउलेबः २ ।   ॰ E.u(T_I32)
        पइ भवति पइ योगः १ ।
    इति
    व्यर्थम् भवति वृएनदबओदय पपओस ।   ॰ end_body(pos)
    पपओस भवति वृसएचबएगइन ४ ।   ॰ pos = sec_begin(4)
    व्यर्थम् भवति वउलेबः १ ।   ॰ E.u(1)
    व्यर्थम् भवति एकलेखः ११२ ।   ॰ E.byte(0x70)
    व्यर्थम् भवति एकलेखः ० ।   ॰ E.byte(0)
    व्यर्थम् भवति वउलेबः पनफ ।   ॰ E.u(nf)
    व्यर्थम् भवति वृएनदबओदय पपओस ।   ॰ end_body(pos)
    पपओस भवति वृसएचबएगइन ५ ।   ॰ pos = sec_begin(5)
    व्यर्थम् भवति वउलेबः १ ।   ॰ E.u(1)
    व्यर्थम् भवति एकलेखः १ ।   ॰ E.byte(1)
    पटम३ भवति वारअमओफफ योगः बिम्बदैर्घ्यम् ।   ॰ E.u((RAMOFF + IMGLEN + 0xFFFF) // 0x10000)
    पटम२ भवति पटम३ योगः ६५५३५ ।   ॰ E.u((RAMOFF + IMGLEN + 0xFFFF) // 0x10000)
    पटम१ भवति पटम२ विभाजनम् ६५५३६ ।   ॰ E.u((RAMOFF + IMGLEN + 0xFFFF) // 0x10000)
    व्यर्थम् भवति वउलेबः पटम१ ।   ॰ E.u((RAMOFF + IMGLEN + 0xFFFF) // 0x10000)
    व्यर्थम् भवति वउलेबः ६५५३६ ।   ॰ E.u(65536)
    व्यर्थम् भवति वृएनदबओदय पपओस ।   ॰ end_body(pos)
    व्यर्थम् भवति वृसएचगलओबअलस पअततएसत ।   ॰ sec_globals(attest)
    व्यर्थम् भवति वृसएचएषपओरतस ० ।   ॰ sec_exports()
    पपओस भवति वृसएचबएगइन ० ।   ॰ pos = sec_begin(0)
    व्यर्थम् भवति वउलेबः ५ ।   ॰ E.str("entry")
    व्यर्थम् भवति अक्षरलेखः वर्णाष्टकम् छचछणजङजगजञ इति ।
    पइ भवति ० ।   ॰ for i in range(4):
    पस्थिर३ भवति ४ ।   ॰ for i in range(4):
    यावत् पइ न्यूनम् पस्थिर३ आदि   ॰ for i in range(4):
        पटम२ भवति ८ गुणनम् पइ ।   ॰ E.byte(ENTRY >> (8 * i))
        पटम१ भवति प्रवेशः दक्षिणसृ पटम२ ।   ॰ E.byte(ENTRY >> (8 * i))
        व्यर्थम् भवति एकलेखः पटम१ ।   ॰ E.byte(ENTRY >> (8 * i))
        पइ भवति पइ योगः १ ।
    इति
    व्यर्थम् भवति वृएनदबओदय पपओस ।   ॰ end_body(pos)
    पपओस भवति वृसएचबएगइन ९ ।   ॰ pos = sec_begin(9)
    व्यर्थम् भवति वउलेबः १ ।   ॰ E.u(1)
    व्यर्थम् भवति एकलेखः ० ।   ॰ E.byte(0)
    व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ ० समाप्तम् ।   ॰ E.i32c(0)
    व्यर्थम् भवति एकलेखः ११ ।   ॰ E.o("end")
    व्यर्थम् भवति वउलेबः पनफ ।   ॰ E.u(nf)
    पइ भवति ० ।   ॰ for i in range(nf):
    पस्थिर४ भवति पनफ ।   ॰ for i in range(nf):
    यावत् पइ न्यूनम् पस्थिर४ आदि   ॰ for i in range(nf):
        पटम१ भवति १९ योगः पइ ।   ॰ E.u(F_SEG0 + i)
        व्यर्थम् भवति वउलेबः पटम१ ।   ॰ E.u(F_SEG0 + i)
        पइ भवति पइ योगः १ ।
    इति
    व्यर्थम् भवति वृएनदबओदय पपओस ।   ॰ end_body(pos)
    पपओस भवति वृसएचबएगइन १० ।   ॰ pos = sec_begin(10)
    पटम१ भवति १६ योगः पनफ ।   ॰ E.u(16 + nf)
    व्यर्थम् भवति वउलेबः पटम१ ।   ॰ E.u(16 + nf)
    पइ भवति ३ ।   ॰ for i in range(F_FLUSH, F_LEFT + 1):
    पस्थिर५ भवति १९ ।   ॰ for i in range(F_FLUSH, F_LEFT + 1):
    यावत् पइ न्यूनम् पस्थिर५ आदि   ॰ for i in range(F_FLUSH, F_LEFT + 1):
        पप२ भवति वृबएगइनबओदय ० ।   ॰ p2 = begin_body()
        व्यर्थम् भवति वृहएमइत पइ ।   ॰ h_emit(i)
        व्यर्थम् भवति वृएनदबओदय पप२ ।   ॰ end_body(p2)
        पइ भवति पइ योगः १ ।
    इति
    यदि पअततएसत समम् ० आदि   ॰ if attest == 0:
        पइ भवति ० ।   ॰ for i in range(NSEG):
        पस्थिर६ भवति वानसएग ।   ॰ for i in range(NSEG):
        यावत् पइ न्यूनम् पस्थिर६ आदि   ॰ for i in range(NSEG):
            व्यर्थम् भवति वृफअसतफउनच पइ ।   ॰ fast_func(i)
            पइ भवति पइ योगः १ ।
        इति
    इति
    पइ भवति ० ।   ॰ for i in range(NSEG):
    पस्थिर७ भवति वानसएग ।   ॰ for i in range(NSEG):
    यावत् पइ न्यूनम् पस्थिर७ आदि   ॰ for i in range(NSEG):
        व्यर्थम् भवति वृसएगफउनच पइ ।   ॰ seg_func(i)
        पइ भवति पइ योगः १ ।
    इति
    व्यर्थम् भवति वृएनदबओदय पपओस ।   ॰ end_body(pos)
    व्यर्थम् भवति वृसएचदअतअ ० ।   ॰ sec_data()
    प्रत्यागमनम् ० ।   ॰ return 0
इति

