            वासलओतर अङ्कः पसइ अन्तः भवति पटम१ ।   ॰ SLOTR[si] = RS2[k]
            पटम२ भवति द्वितीयस्रोताः अङ्कः पक अन्तः ।   ॰ SLOTV[si] = REGVER[RS2[k]]
            पटम१ भवति वारएगभएर अङ्कः पटम२ अन्तः ।   ॰ SLOTV[si] = REGVER[RS2[k]]
            वासलओतभ अङ्कः पसइ अन्तः भवति पटम१ ।   ॰ SLOTV[si] = REGVER[RS2[k]]
        इति
        प्रत्यागमनम् ० ।   ॰ return 0
    इति
