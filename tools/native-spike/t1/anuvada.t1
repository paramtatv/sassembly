        यावत् पइ न्यूनम् पस्थिर३ आदि   ॰ for i in range(2):
            पस भवति वृसएगसउचच आरभ्य पभ ऽ पइ समाप्तम् ।   ॰ s = seg_succ(v, i)
            यदि पस बृहत्समम् ० आदि   ॰ if s >= 0:
                पटम२ भवति पस वियोगः पअ ।   ॰ PSTART[s - a + 1] += 1
                पटम१ भवति पटम२ योगः १ ।   ॰ PSTART[s - a + 1] += 1
                पटम६ भवति पस वियोगः पअ ।   ॰ PSTART[s - a + 1] += 1
                पटम५ भवति पटम६ योगः १ ।   ॰ PSTART[s - a + 1] += 1
                पटम४ भवति वापसतअरत अङ्कः पटम५ अन्तः ।   ॰ PSTART[s - a + 1] += 1
                पटम३ भवति पटम४ योगः १ ।   ॰ PSTART[s - a + 1] += 1
                वापसतअरत अङ्कः पटम१ अन्तः भवति पटम३ ।   ॰ PSTART[s - a + 1] += 1
            इति
            पइ भवति पइ योगः १ ।
        इति
        पभ भवति पभ योगः १ ।
    इति
    पभ भवति पअ ।   ॰ for v in range(a, b):
    पस्थिर४ भवति पब ।   ॰ for v in range(a, b):
    यावत् पभ न्यूनम् पस्थिर४ आदि   ॰ for v in range(a, b):
        पटम२ भवति पभ वियोगः पअ ।   ॰ PSTART[v - a + 1] += PSTART[v - a]
        पटम१ भवति पटम२ योगः १ ।   ॰ PSTART[v - a + 1] += PSTART[v - a]
        पटम६ भवति पभ वियोगः पअ ।   ॰ PSTART[v - a + 1] += PSTART[v - a]
        पटम५ भवति पटम६ योगः १ ।   ॰ PSTART[v - a + 1] += PSTART[v - a]
        पटम४ भवति वापसतअरत अङ्कः पटम५ अन्तः ।   ॰ PSTART[v - a + 1] += PSTART[v - a]
        पटम८ भवति पभ वियोगः पअ ।   ॰ PSTART[v - a + 1] += PSTART[v - a]
        पटम७ भवति वापसतअरत अङ्कः पटम८ अन्तः ।   ॰ PSTART[v - a + 1] += PSTART[v - a]
        पटम३ भवति पटम४ योगः पटम७ ।   ॰ PSTART[v - a + 1] += PSTART[v - a]
        वापसतअरत अङ्कः पटम१ अन्तः भवति पटम३ ।   ॰ PSTART[v - a + 1] += PSTART[v - a]
        पभ भवति पभ योगः १ ।
