            वानबलक भवति वानबलक योगः १ ।   ॰ NBLK += 1
        इति
        पक भवति पक योगः १ ।
    इति
    पज भवति ० ।   ॰ for j in range(NBLK):
    पस्थिर६ भवति वानबलक ।   ॰ for j in range(NBLK):
    यावत् पज न्यूनम् पस्थिर६ आदि   ॰ for j in range(NBLK):
        पनषत भवति शब्दगणना ।   ॰ nxt = NWORDS
        पटम१ भवति पज योगः १ ।   ॰ if j + 1 < NBLK:
        यदि पटम१ न्यूनम् वानबलक आदि   ॰ if j + 1 < NBLK:
            पटम१ भवति पज योगः १ ।   ॰ nxt = STARTS[j + 1]
            पनषत भवति वासतअरतस अङ्कः पटम१ अन्तः ।   ॰ nxt = STARTS[j + 1]
        इति
        पटम२ भवति वासतअरतस अङ्कः पज अन्तः ।   ॰ BLEN[j] = nxt - STARTS[j]
        पटम१ भवति पनषत वियोगः पटम२ ।   ॰ BLEN[j] = nxt - STARTS[j]
        वाबलएन अङ्कः पज अन्तः भवति पटम१ ।   ॰ BLEN[j] = nxt - STARTS[j]
        पज भवति पज योगः १ ।
    इति
    वानसएग भवति ० ।   ॰ NSEG = 0
    पइ भवति ० ।   ॰ i = 0
    यावत् पइ न्यूनम् वानबलक आदि   ॰ while i < NBLK:
        पज भवति पइ ।   ॰ j = i
        पअचच भवति ० ।   ॰ acc = 0
        पस्थिर७ भवति १ ।   ॰ while j < NBLK and acc < SEGW:
        यावत् पस्थिर७ समम् १ आदि   ॰ while j < NBLK and acc < SEGW:
            पटम१ भवति ० ।   ॰ while j < NBLK and acc < SEGW:
            यदि पज न्यूनम् वानबलक आदि   ॰ while j < NBLK and acc < SEGW:
                पटम१ भवति १ ।
            इति
            यदि पटम१ समम् १ आदि   ॰ while j < NBLK and acc < SEGW:
                पटम२ भवति ० ।   ॰ while j < NBLK and acc < SEGW:
                यदि पअचच न्यूनम् ४०९६ आदि   ॰ while j < NBLK and acc < SEGW:
                    पटम२ भवति १ ।
                इति
                पटम१ भवति पटम२ ।
            इति
            पस्थिर७ भवति ० ।
            यदि पटम१ समम् १ आदि
                पस्थिर७ भवति १ ।
            इति
            यदि पस्थिर७ समम् १ आदि
                पटम१ भवति वाबलएन अङ्कः पज अन्तः ।   ॰ acc += BLEN[j]
                पअचच भवति पअचच योगः पटम१ ।   ॰ acc += BLEN[j]
                पज भवति पज योगः १ ।   ॰ j += 1
            इति
        इति
        वासएगअ अङ्कः वानसएग अन्तः भवति पइ ।   ॰ SEGA[NSEG] = i
        वासएगब अङ्कः वानसएग अन्तः भवति पज ।   ॰ SEGB[NSEG] = j
        पख भवति पइ ।   ॰ for q in range(i, j):
        पस्थिर८ भवति पज ।   ॰ for q in range(i, j):
        यावत् पख न्यूनम् पस्थिर८ आदि   ॰ for q in range(i, j):
            वासएगओफ अङ्कः पख अन्तः भवति वानसएग ।   ॰ SEGOF[q] = NSEG
            पख भवति पख योगः १ ।
        इति
        वानसएग भवति वानसएग योगः १ ।   ॰ NSEG += 1
        पइ भवति पज ।   ॰ i = j
    इति
    पटम४ भवति ४ गुणनम् शब्दगणना ।   ॰ SEGOFAT = (WL_JT + 4 * NWORDS + 15) // 16 * 16
    पटम३ भवति ६५७९२ योगः पटम४ ।   ॰ SEGOFAT = (WL_JT + 4 * NWORDS + 15) // 16 * 16
    पटम२ भवति पटम३ योगः १५ ।   ॰ SEGOFAT = (WL_JT + 4 * NWORDS + 15) // 16 * 16
    पटम१ भवति पटम२ विभाजनम् १६ ।   ॰ SEGOFAT = (WL_JT + 4 * NWORDS + 15) // 16 * 16
    वासएगओफअत भवति पटम१ गुणनम् १६ ।   ॰ SEGOFAT = (WL_JT + 4 * NWORDS + 15) // 16 * 16
    पटम४ भवति २ गुणनम् वानबलक ।   ॰ RAMOFF = (SEGOFAT + 2 * NBLK + 0xFFFF) // 0x10000 * 0x10000
    पटम३ भवति वासएगओफअत योगः पटम४ ।   ॰ RAMOFF = (SEGOFAT + 2 * NBLK + 0xFFFF) // 0x10000 * 0x10000
    पटम२ भवति पटम३ योगः ६५५३५ ।   ॰ RAMOFF = (SEGOFAT + 2 * NBLK + 0xFFFF) // 0x10000 * 0x10000
    पटम१ भवति पटम२ विभाजनम् ६५५३६ ।   ॰ RAMOFF = (SEGOFAT + 2 * NBLK + 0xFFFF) // 0x10000 * 0x10000
    वारअमओफफ भवति पटम१ गुणनम् ६५५३६ ।   ॰ RAMOFF = (SEGOFAT + 2 * NBLK + 0xFFFF) // 0x10000 * 0x10000
    प्रत्यागमनम् ० ।
इति

॰ rget -> वृरगएत
वृत्तिः वृरगएत आदाय पन ॱॱ अ६४ ददाति अ६४ आदि
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    यदि पन समम् ० आदि   ॰ if n == 0:
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ ० समाप्तम् ।   ॰ E.i64c(0)
    इति अन्यथा आदि
        पटम१ भवति पन वियोगः १ ।   ॰ E.lget(n - 1)
        व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ पटम१ समाप्तम् ।   ॰ E.lget(n - 1)
    इति
    प्रत्यागमनम् ० ।
इति

॰ rput -> वृरपउत
वृत्तिः वृरपउत आदाय पन ॱॱ अ६४ ददाति अ६४ आदि
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    पटम१ भवति ० ।   ॰ if n:
    यदि पन असमम् ० आदि   ॰ if n:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if n:
        पटम१ भवति पन वियोगः १ ।   ॰ E.lset(n - 1)
        व्यर्थम् भवति वक्रियाः आरभ्य ३३ ऽ पटम१ समाप्तम् ।   ॰ E.lset(n - 1)
    इति अन्यथा आदि
        व्यर्थम् भवति एकलेखः २६ ।   ॰ E.o("drop")
    इति
    प्रत्यागमनम् ० ।
इति

॰ fault -> वृफअउलत
वृत्तिः वृफअउलत आदाय पकइनद ॱॱ अ६४ ऽ पपच ॱॱ अ६४ ऽ पअलओच ॱॱ अ६४ ऽ पअभअल ॱॱ अ६४ ऽ पभलओच ॱॱ अ६४ ऽ पभभअल ॱॱ अ६४ ऽ परएफउनद ॱॱ अ६४ ददाति अ६४ आदि
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    यदि पकइनद न्यूनम् ० आदि   ॰ if kind < 0:
        व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ ३९ समाप्तम् ।   ॰ E.lget(LOC_K)
    इति अन्यथा आदि
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ पकइनद समाप्तम् ।   ॰ E.i32c(kind)
    इति
    व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पपच समाप्तम् ।   ॰ E.i64c(pc)
    पटम१ भवति ० ।   ॰ if aloc:
    यदि पअलओच असमम् ० आदि   ॰ if aloc:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if aloc:
        व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ पअभअल समाप्तम् ।   ॰ E.lget(aval)
    इति अन्यथा आदि
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पअभअल समाप्तम् ।   ॰ E.i64c(aval)
    इति
    पटम१ भवति ० ।   ॰ if vloc:
    यदि पभलओच असमम् ० आदि   ॰ if vloc:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if vloc:
        व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ पभभअल समाप्तम् ।   ॰ E.lget(vval)
    इति अन्यथा आदि
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पभभअल समाप्तम् ।   ॰ E.i64c(vval)
    इति
    व्यर्थम् भवति वक्रियाः आरभ्य १६ ऽ ४ समाप्तम् ।   ॰ E.call(F_HALT)
    पटम१ भवति ० ।   ॰ if refund and ATTEST == 0:
    यदि परएफउनद असमम् ० आदि   ॰ if refund and ATTEST == 0:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if refund and ATTEST == 0:
        पटम२ भवति ० ।   ॰ if refund and ATTEST == 0:
        यदि वाअततएसत समम् ० आदि   ॰ if refund and ATTEST == 0:
            पटम२ भवति १ ।
        इति
        पटम१ भवति पटम२ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if refund and ATTEST == 0:
        व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ ३२ समाप्तम् ।   ॰ E.lget(LOC_TICKS)
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ परएफउनद समाप्तम् ।   ॰ E.i64c(refund)
        व्यर्थम् भवति एकलेखः १२४ ।   ॰ E.o("i64.add")
        व्यर्थम् भवति वक्रियाः आरभ्य ३३ ऽ ३२ समाप्तम् ।   ॰ E.lset(LOC_TICKS)
    इति
    पटम१ भवति वाचतषचनत योगः वाचतषनएसत ।   ॰ E.br(CTXCNT + CTXNEST)
    व्यर्थम् भवति वक्रियाः आरभ्य १२ ऽ पटम१ समाप्तम् ।   ॰ E.br(CTXCNT + CTXNEST)
    प्रत्यागमनम् ० ।
इति

॰ goto_blk -> वृगओतओबलक
वृत्तिः वृगओतओबलक आदाय पबइ ॱॱ अ६४ ददाति अ६४ आदि
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ पबइ समाप्तम् ।   ॰ E.i32c(bi)
    व्यर्थम् भवति वक्रियाः आरभ्य ३३ ऽ ३७ समाप्तम् ।   ॰ E.lset(LOC_BLK)
    पटम२ भवति वाचतषचनत योगः वाचतषनएसत ।   ॰ E.br(CTXCNT + CTXNEST + 2)
    पटम१ भवति पटम२ योगः २ ।   ॰ E.br(CTXCNT + CTXNEST + 2)
    व्यर्थम् भवति वक्रियाः आरभ्य १२ ऽ पटम१ समाप्तम् ।   ॰ E.br(CTXCNT + CTXNEST + 2)
    प्रत्यागमनम् ० ।
इति

॰ direct_target -> वृदइरएचततअरगएत
वृत्तिः वृदइरएचततअरगएत आदाय पपच ॱॱ अ६४ ऽ पइमम ॱॱ अ६४ ददाति अ६४ आदि
    चरः पत ॱॱ अ६४ भवति ० ।
    चरः पर ॱॱ अ६४ भवति ० ।
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    चरः पटम३ ॱॱ अ६४ भवति ० ।
    चरः पटम४ ॱॱ अ६४ भवति ० ।
    चरः पटम५ ॱॱ अ६४ भवति ० ।
    चरः पटम६ ॱॱ अ६४ भवति ० ।
    पत भवति पपच योगः पइमम ।   ॰ t = pc + imm
    पर भवति ऋण१ ।   ॰ r = -1
    पटम१ भवति ० ।   ॰ if t >= WBASE and t < WBASE + 4 * NWORDS and t % 4 == 0:
    यदि पत बृहत्समम् २१४७४८३६४८ आदि   ॰ if t >= WBASE and t < WBASE + 4 * NWORDS and t % 4 == 0:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if t >= WBASE and t < WBASE + 4 * NWORDS and t % 4 == 0:
        पटम३ भवति ४ गुणनम् शब्दगणना ।   ॰ if t >= WBASE and t < WBASE + 4 * NWORDS and t % 4 == 0:
        पटम२ भवति २१४७४८३६४८ योगः पटम३ ।   ॰ if t >= WBASE and t < WBASE + 4 * NWORDS and t % 4 == 0:
        पटम४ भवति ० ।   ॰ if t >= WBASE and t < WBASE + 4 * NWORDS and t % 4 == 0:
        यदि पत न्यूनम् पटम२ आदि   ॰ if t >= WBASE and t < WBASE + 4 * NWORDS and t % 4 == 0:
            पटम४ भवति १ ।
        इति
        पटम१ भवति पटम४ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if t >= WBASE and t < WBASE + 4 * NWORDS and t % 4 == 0:
        पटम५ भवति पत शेषः ४ ।   ॰ if t >= WBASE and t < WBASE + 4 * NWORDS and t % 4 == 0:
        पटम६ भवति ० ।   ॰ if t >= WBASE and t < WBASE + 4 * NWORDS and t % 4 == 0:
        यदि पटम५ समम् ० आदि   ॰ if t >= WBASE and t < WBASE + 4 * NWORDS and t % 4 == 0:
            पटम६ भवति १ ।
        इति
        पटम१ भवति पटम६ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if t >= WBASE and t < WBASE + 4 * NWORDS and t % 4 == 0:
        पटम२ भवति पत वियोगः २१४७४८३६४८ ।   ॰ r = BLKOF[(t - WBASE) // 4]
        पटम१ भवति पटम२ विभाजनम् ४ ।   ॰ r = BLKOF[(t - WBASE) // 4]
        पर भवति वाबलकओफ अङ्कः पटम१ अन्तः ।   ॰ r = BLKOF[(t - WBASE) // 4]
    इति
    प्रत्यागमनम् पर ।   ॰ return r
इति

॰ lower_ctl -> वृलओवएरचतल
वृत्तिः वृलओवएरचतल आदाय पक ॱॱ अ६४ ऽ पपच ॱॱ अ६४ ऽ परएफउनद ॱॱ अ६४ ददाति अ६४ आदि
    चरः पओप ॱॱ अ६४ भवति ० ।
    चरः परद ॱॱ अ६४ भवति ० ।
    चरः परस१ ॱॱ अ६४ भवति ० ।
    चरः परस२ ॱॱ अ६४ भवति ० ।
    चरः पइमम ॱॱ अ६४ भवति ० ।
    चरः पतब ॱॱ अ६४ भवति ० ।
    चरः पच ॱॱ अ६४ भवति ० ।
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    पओप भवति क्रियाः अङ्कः पक अन्तः ।   ॰ op = OPS[k]
    परद भवति लक्ष्याणि अङ्कः पक अन्तः ।   ॰ rd = RD[k]
    परस१ भवति प्रथमस्रोताः अङ्कः पक अन्तः ।   ॰ rs1 = RS1[k]
    परस२ भवति द्वितीयस्रोताः अङ्कः पक अन्तः ।   ॰ rs2 = RS2[k]
    पइमम भवति मात्राः अङ्कः पक अन्तः ।   ॰ imm = IMM[k]
    यदि पओप समम् १ आदि   ॰ if op == K_LUI:
        पटम१ भवति ० ।   ॰ if rd:
        यदि परद असमम् ० आदि   ॰ if rd:
            पटम१ भवति १ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if rd:
            व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पइमम समाप्तम् ।   ॰ E.i64c(imm)
            व्यर्थम् भवति वृरपउत परद ।   ॰ rput(rd)
        इति
    इति
    यदि पओप समम् २ आदि   ॰ if op == K_AUIPC:
        पटम१ भवति ० ।   ॰ if rd:
        यदि परद असमम् ० आदि   ॰ if rd:
            पटम१ भवति १ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if rd:
            पटम१ भवति पपच योगः पइमम ।   ॰ E.i64c(pc + imm)
            व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पटम१ समाप्तम् ।   ॰ E.i64c(pc + imm)
            व्यर्थम् भवति वृरपउत परद ।   ॰ rput(rd)
        इति
    इति
    यदि पओप समम् ३ आदि   ॰ if op == K_JAL:
        पटम१ भवति ० ।   ॰ if rd:
        यदि परद असमम् ० आदि   ॰ if rd:
            पटम१ भवति १ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if rd:
            पटम१ भवति पपच योगः ४ ।   ॰ E.i64c(pc + 4)
            व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पटम१ समाप्तम् ।   ॰ E.i64c(pc + 4)
            व्यर्थम् भवति वृरपउत परद ।   ॰ rput(rd)
        इति
        पतब भवति वृदइरएचततअरगएत आरभ्य पपच ऽ पइमम समाप्तम् ।   ॰ tb = direct_target(pc, imm)
        यदि पतब बृहत्समम् ० आदि   ॰ if tb >= 0:
            व्यर्थम् भवति वृगओतओबलक पतब ।   ॰ goto_blk(tb)
        इति अन्यथा आदि
            पटम१ भवति पपच योगः पइमम ।   ॰ fault(8, pc, 0, pc + imm, 0, 0, refund)
            व्यर्थम् भवति वृफअउलत आरभ्य ८ ऽ पपच ऽ ० ऽ पटम१ ऽ ० ऽ ० ऽ परएफउनद समाप्तम् ।   ॰ fault(8, pc, 0, pc + imm, 0, 0, refund)
        इति
    इति
    यदि पओप समम् ४ आदि   ॰ if op == K_JALR:
        व्यर्थम् भवति वृरगएत परस१ ।   ॰ rget(rs1)
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पइमम समाप्तम् ।   ॰ E.i64c(imm)
        व्यर्थम् भवति एकलेखः १२४ ।   ॰ E.o("i64.add")
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ ऋण२ समाप्तम् ।   ॰ E.i64c(-2)
        व्यर्थम् भवति एकलेखः १३१ ।   ॰ E.o("i64.and")
        व्यर्थम् भवति वक्रियाः आरभ्य ३३ ऽ ३६ समाप्तम् ।   ॰ E.lset(LOC_T)
        पटम१ भवति ० ।   ॰ if rd:
        यदि परद असमम् ० आदि   ॰ if rd:
            पटम१ भवति १ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if rd:
            पटम१ भवति पपच योगः ४ ।   ॰ E.i64c(pc + 4)
            व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पटम१ समाप्तम् ।   ॰ E.i64c(pc + 4)
            व्यर्थम् भवति वृरपउत परद ।   ॰ rput(rd)
        इति
        व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ ३६ समाप्तम् ।   ॰ E.lget(LOC_T)
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ २१४७४८३६४८ समाप्तम् ।   ॰ E.i64c(WBASE)
        व्यर्थम् भवति एकलेखः १२५ ।   ॰ E.o("i64.sub")
        व्यर्थम् भवति वक्रियाः आरभ्य ३४ ऽ ३४ समाप्तम् ।   ॰ E.ltee(LOC_OFF)
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ सङ्केतदैर्घ्यम् समाप्तम् ।   ॰ E.i64c(CODE_SIZE)
        व्यर्थम् भवति एकलेखः ९० ।   ॰ E.o("i64.ge_u")
        व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ ३४ समाप्तम् ।   ॰ E.lget(LOC_OFF)
        व्यर्थम् भवति एकलेखः १६७ ।   ॰ E.o("i32.wrap_i64")
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ ३ समाप्तम् ।   ॰ E.i32c(3)
        व्यर्थम् भवति अक्षरलेखः वर्णाष्टकम् जखजगकङङक इति ।
        वाचतषनएसत भवति १ ।   ॰ CTXNEST = 1
        व्यर्थम् भवति वृफअउलत आरभ्य ८ ऽ पपच ऽ १ ऽ ३६ ऽ ० ऽ ० ऽ परएफउनद समाप्तम् ।   ॰ fault(8, pc, 1, LOC_T, 0, 0, refund)
        वाचतषनएसत भवति ० ।   ॰ CTXNEST = 0
        व्यर्थम् भवति एकलेखः ११ ।   ॰ E.o("end")
        व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ ३४ समाप्तम् ।   ॰ E.lget(LOC_OFF)
        व्यर्थम् भवति एकलेखः १६७ ।   ॰ E.o("i32.wrap_i64")
        व्यर्थम् भवति वस्मृतिः आरभ्य ४० ऽ २ ऽ ६५७९२ समाप्तम् ।   ॰ E.mem("i32.load", WL_JT)
        व्यर्थम् भवति वक्रियाः आरभ्य ३४ ऽ ३७ समाप्तम् ।   ॰ E.ltee(LOC_BLK)
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ ० समाप्तम् ।   ॰ E.i32c(0)
        व्यर्थम् भवति अक्षरलेखः वर्णाष्टकम् ङझकङङक इति ।
        वाचतषनएसत भवति १ ।   ॰ CTXNEST = 1
        व्यर्थम् भवति वृफअउलत आरभ्य ११ ऽ पपच ऽ १ ऽ ३६ ऽ ० ऽ ० ऽ परएफउनद समाप्तम् ।   ॰ fault(11, pc, 1, LOC_T, 0, 0, refund)
        वाचतषनएसत भवति ० ।   ॰ CTXNEST = 0
        व्यर्थम् भवति एकलेखः ११ ।   ॰ E.o("end")
        पटम२ भवति वाचतषचनत योगः वाचतषनएसत ।   ॰ E.br(CTXCNT + CTXNEST + 2)
        पटम१ भवति पटम२ योगः २ ।   ॰ E.br(CTXCNT + CTXNEST + 2)
        व्यर्थम् भवति वक्रियाः आरभ्य १२ ऽ पटम१ समाप्तम् ।   ॰ E.br(CTXCNT + CTXNEST + 2)
    इति
    पटम१ भवति ० ।   ॰ if op >= K_BEQ and op <= K_BGEU:
    यदि पओप बृहत्समम् ५ आदि   ॰ if op >= K_BEQ and op <= K_BGEU:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if op >= K_BEQ and op <= K_BGEU:
        पटम२ भवति ० ।   ॰ if op >= K_BEQ and op <= K_BGEU:
        यदि १० बृहत्समम् पओप आदि   ॰ if op >= K_BEQ and op <= K_BGEU:
            पटम२ भवति १ ।
        इति
        पटम१ भवति पटम२ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if op >= K_BEQ and op <= K_BGEU:
        व्यर्थम् भवति वृरगएत परस१ ।   ॰ rget(rs1)
        व्यर्थम् भवति वृरगएत परस२ ।   ॰ rget(rs2)
        पच भवति ८१ ।   ॰ c = I64_EQ
        यदि पओप समम् ६ आदि   ॰ if op == K_BNE:
            पच भवति ८२ ।   ॰ c = I64_NE
        इति
        यदि पओप समम् ७ आदि   ॰ if op == K_BLT:
            पच भवति ८३ ।   ॰ c = I64_LT_S
        इति
        यदि पओप समम् ८ आदि   ॰ if op == K_BGE:
            पच भवति ८९ ।   ॰ c = I64_GE_S
        इति
        यदि पओप समम् ९ आदि   ॰ if op == K_BLTU:
            पच भवति ८४ ।   ॰ c = I64_LT_U
        इति
        यदि पओप समम् १० आदि   ॰ if op == K_BGEU:
            पच भवति ९० ।   ॰ c = I64_GE_U
        इति
        व्यर्थम् भवति एकलेखः पच ।   ॰ E.byte(c)
        व्यर्थम् भवति एकलेखः ४ ।   ॰ E.blk("if")
        व्यर्थम् भवति एकलेखः ६४ ।   ॰ E.blk("if")
        वाचतषनएसत भवति १ ।   ॰ CTXNEST = 1
        पतब भवति वृदइरएचततअरगएत आरभ्य पपच ऽ पइमम समाप्तम् ।   ॰ tb = direct_target(pc, imm)
        यदि पतब बृहत्समम् ० आदि   ॰ if tb >= 0:
            व्यर्थम् भवति वृगओतओबलक पतब ।   ॰ goto_blk(tb)
        इति अन्यथा आदि
            पटम१ भवति पपच योगः पइमम ।   ॰ fault(8, pc, 0, pc + imm, 0, 0, refund)
            व्यर्थम् भवति वृफअउलत आरभ्य ८ ऽ पपच ऽ ० ऽ पटम१ ऽ ० ऽ ० ऽ परएफउनद समाप्तम् ।   ॰ fault(8, pc, 0, pc + imm, 0, 0, refund)
        इति
        वाचतषनएसत भवति ० ।   ॰ CTXNEST = 0
        व्यर्थम् भवति एकलेखः ११ ।   ॰ E.o("end")
    इति
    प्रत्यागमनम् ० ।
इति

॰ lim_index -> वृलइमइनदएष
वृत्तिः वृलइमइनदएष आदाय पवद ॱॱ अ६४ ददाति अ६४ आदि
    चरः पर ॱॱ अ६४ भवति ० ।
    पर भवति ० ।   ॰ r = 0
    यदि पवद समम् २ आदि   ॰ if wd == 2:
        पर भवति १ ।   ॰ r = 1
    इति
    यदि पवद समम् ४ आदि   ॰ if wd == 4:
        पर भवति २ ।   ॰ r = 2
    इति
    यदि पवद समम् ८ आदि   ॰ if wd == 8:
        पर भवति ३ ।   ॰ r = 3
    इति
    प्रत्यागमनम् पर ।   ॰ return r
इति

॰ wd_align -> वृवदअलइगन
वृत्तिः वृवदअलइगन आदाय पवद ॱॱ अ६४ ददाति अ६४ आदि
    चरः पर ॱॱ अ६४ भवति ० ।
    पर भवति ० ।   ॰ r = 0
    यदि पवद समम् २ आदि   ॰ if wd == 2:
        पर भवति १ ।   ॰ r = 1
    इति
    यदि पवद समम् ४ आदि   ॰ if wd == 4:
        पर भवति २ ।   ॰ r = 2
    इति
    यदि पवद समम् ८ आदि   ॰ if wd == 8:
        पर भवति ३ ।   ॰ r = 3
    इति
    प्रत्यागमनम् पर ।   ॰ return r
इति

॰ lower_load -> वृलओवएरलओअद
वृत्तिः वृलओवएरलओअद आदाय पक ॱॱ अ६४ ऽ पपच ॱॱ अ६४ ऽ परएफउनद ॱॱ अ६४ ददाति अ६४ आदि
    चरः पओप ॱॱ अ६४ भवति ० ।
    चरः परद ॱॱ अ६४ भवति ० ।
    चरः पवद ॱॱ अ६४ भवति ० ।
    चरः पलद ॱॱ अ६४ भवति ० ।
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    पओप भवति क्रियाः अङ्कः पक अन्तः ।   ॰ op = OPS[k]
    परद भवति लक्ष्याणि अङ्कः पक अन्तः ।   ॰ rd = RD[k]
    पवद भवति ८ ।   ॰ wd = 8
    पलद भवति ४१ ।   ॰ ld = 0x29
    यदि पओप समम् ११ आदि   ॰ if op == K_LB:
        पवद भवति १ ।   ॰ wd = 1
        पलद भवति ४८ ।   ॰ ld = 0x30
    इति
    यदि पओप समम् १५ आदि   ॰ if op == K_LBU:
        पवद भवति १ ।   ॰ wd = 1
        पलद भवति ४९ ।   ॰ ld = 0x31
    इति
    यदि पओप समम् १२ आदि   ॰ if op == K_LH:
        पवद भवति २ ।   ॰ wd = 2
        पलद भवति ५० ।   ॰ ld = 0x32
    इति
    यदि पओप समम् १६ आदि   ॰ if op == K_LHU:
        पवद भवति २ ।   ॰ wd = 2
        पलद भवति ५१ ।   ॰ ld = 0x33
    इति
    यदि पओप समम् १३ आदि   ॰ if op == K_LW:
        पवद भवति ४ ।   ॰ wd = 4
        पलद भवति ५२ ।   ॰ ld = 0x34
    इति
    यदि पओप समम् १७ आदि   ॰ if op == K_LWU:
        पवद भवति ४ ।   ॰ wd = 4
        पलद भवति ५३ ।   ॰ ld = 0x35
    इति
    पटम१ भवति प्रथमस्रोताः अङ्कः पक अन्तः ।   ॰ rget(RS1[k])
    व्यर्थम् भवति वृरगएत पटम१ ।   ॰ rget(RS1[k])
    पटम१ भवति मात्राः अङ्कः पक अन्तः ।   ॰ E.i64c(IMM[k])
    व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पटम१ समाप्तम् ।   ॰ E.i64c(IMM[k])
    व्यर्थम् भवति एकलेखः १२४ ।   ॰ E.o("i64.add")
    व्यर्थम् भवति वक्रियाः आरभ्य ३३ ऽ ३३ समाप्तम् ।   ॰ E.lset(LOC_EA)
    व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ ३३ समाप्तम् ।   ॰ E.lget(LOC_EA)
    व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ २१४७४८३६४८ समाप्तम् ।   ॰ E.i64c(WBASE)
    व्यर्थम् भवति एकलेखः १२५ ।   ॰ E.o("i64.sub")
    व्यर्थम् भवति वक्रियाः आरभ्य ३४ ऽ ३४ समाप्तम् ।   ॰ E.ltee(LOC_OFF)
    पटम२ भवति वृलइमइनदएष पवद ।   ॰ E.gget(G_LL + lim_index(wd))
    पटम१ भवति ३४ योगः पटम२ ।   ॰ E.gget(G_LL + lim_index(wd))
    व्यर्थम् भवति वक्रियाः आरभ्य ३५ ऽ पटम१ समाप्तम् ।   ॰ E.gget(G_LL + lim_index(wd))
    व्यर्थम् भवति अक्षरलेखः वर्णाष्टकम् चटकङङक इति ।
    वाचतषनएसत भवति १ ।   ॰ CTXNEST = 1
    व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ २ समाप्तम् ।   ॰ E.i32c(2)
    व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ ३ समाप्तम् ।   ॰ E.i32c(3)
    व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ ३३ समाप्तम् ।   ॰ E.lget(LOC_EA)
    व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ २१४७४८३६४८ समाप्तम् ।   ॰ E.i64c(1 << 31)
    व्यर्थम् भवति एकलेखः ८४ ।   ॰ E.o("i64.lt_u")
    व्यर्थम् भवति एकलेखः २७ ।   ॰ E.o("select")
    व्यर्थम् भवति वक्रियाः आरभ्य ३३ ऽ ३९ समाप्तम् ।   ॰ E.lset(LOC_K)
    व्यर्थम् भवति वृफअउलत आरभ्य ऋण१ ऽ पपच ऽ १ ऽ ३३ ऽ ० ऽ ० ऽ परएफउनद समाप्तम् ।   ॰ fault(-1, pc, 1, LOC_EA, 0, 0, refund)
    वाचतषनएसत भवति ० ।   ॰ CTXNEST = 0
    व्यर्थम् भवति एकलेखः ११ ।   ॰ E.o("end")
    यदि पओप समम् १८ आदि   ॰ if op == K_FLD:
        पटम२ भवति ८ गुणनम् परद ।   ॰ E.i32c(WL_FREGS + 8 * rd)
        पटम१ भवति ६५५३६ योगः पटम२ ।   ॰ E.i32c(WL_FREGS + 8 * rd)
