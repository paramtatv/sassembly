    पस्थिर५ भवति पब ।   ॰ for v in range(a, b):
    यावत् पभ न्यूनम् पस्थिर५ आदि   ॰ for v in range(a, b):
        पटम१ भवति पभ वियोगः पअ ।   ॰ PFILL[v - a] = PSTART[v - a]
        पटम३ भवति पभ वियोगः पअ ।   ॰ PFILL[v - a] = PSTART[v - a]
        पटम२ भवति वापसतअरत अङ्कः पटम३ अन्तः ।   ॰ PFILL[v - a] = PSTART[v - a]
        वापफइलल अङ्कः पटम१ अन्तः भवति पटम२ ।   ॰ PFILL[v - a] = PSTART[v - a]
        पभ भवति पभ योगः १ ।
    इति
    पभ भवति पअ ।   ॰ for v in range(a, b):
    पस्थिर६ भवति पब ।   ॰ for v in range(a, b):
    यावत् पभ न्यूनम् पस्थिर६ आदि   ॰ for v in range(a, b):
        पइ भवति ० ।   ॰ for i in range(2):
        पस्थिर७ भवति २ ।   ॰ for i in range(2):
        यावत् पइ न्यूनम् पस्थिर७ आदि   ॰ for i in range(2):
            पस भवति वृसएगसउचच आरभ्य पभ ऽ पइ समाप्तम् ।   ॰ s = seg_succ(v, i)
            यदि पस बृहत्समम् ० आदि   ॰ if s >= 0:
                पटम२ भवति पस वियोगः पअ ।   ॰ PLIST[PFILL[s - a]] = v
                पटम१ भवति वापफइलल अङ्कः पटम२ अन्तः ।   ॰ PLIST[PFILL[s - a]] = v
                वापलइसत अङ्कः पटम१ अन्तः भवति पभ ।   ॰ PLIST[PFILL[s - a]] = v
                पटम१ भवति पस वियोगः पअ ।   ॰ PFILL[s - a] += 1
                पटम४ भवति पस वियोगः पअ ।   ॰ PFILL[s - a] += 1
                पटम३ भवति वापफइलल अङ्कः पटम४ अन्तः ।   ॰ PFILL[s - a] += 1
                पटम२ भवति पटम३ योगः १ ।   ॰ PFILL[s - a] += 1
                वापफइलल अङ्कः पटम१ अन्तः भवति पटम२ ।   ॰ PFILL[s - a] += 1
            इति
            पइ भवति पइ योगः १ ।
        इति
        पभ भवति पभ योगः १ ।
    इति
    पभ भवति पअ ।   ॰ for v in range(a, b):
    पस्थिर८ भवति पब ।   ॰ for v in range(a, b):
    यावत् पभ न्यूनम् पस्थिर८ आदि   ॰ for v in range(a, b):
        वारपओन अङ्कः पभ अन्तः भवति ऋण१ ।   ॰ RPON[v] = -1
        पभ भवति पभ योगः १ ।
    इति
    पपओसत भवति ० ।   ॰ post = 0
    पर भवति पअ ।   ॰ for r in range(a, b):
    पस्थिर९ भवति पब ।   ॰ for r in range(a, b):
    यावत् पर न्यूनम् पस्थिर९ आदि   ॰ for r in range(a, b):
        पटम१ भवति वारपओन अङ्कः पर अन्तः ।   ॰ if RPON[r] == -1:
        यदि पटम१ समम् ऋण१ आदि   ॰ if RPON[r] == -1:
            पपओसत० भवति पपओसत ।   ॰ post0 = post
            वारपओन अङ्कः पर अन्तः भवति ऋण२ ।   ॰ RPON[r] = -2
            वादसतक अङ्कः ० अन्तः भवति पर ।   ॰ DSTK[0] = r
            वादइत अङ्कः ० अन्तः भवति ० ।   ॰ DIT[0] = 0
            पसप भवति १ ।   ॰ sp = 1
            यावत् पसप अधिकम् ० आदि   ॰ while sp > 0:
                पटम१ भवति पसप वियोगः १ ।   ॰ v = DSTK[sp - 1]
                पभ भवति वादसतक अङ्कः पटम१ अन्तः ।   ॰ v = DSTK[sp - 1]
                पटम१ भवति पसप वियोगः १ ।   ॰ i = DIT[sp - 1]
                पइ भवति वादइत अङ्कः पटम१ अन्तः ।   ॰ i = DIT[sp - 1]
                यदि पइ न्यूनम् २ आदि   ॰ if i < 2:
                    पटम१ भवति पसप वियोगः १ ।   ॰ DIT[sp - 1] = i + 1
                    पटम२ भवति पइ योगः १ ।   ॰ DIT[sp - 1] = i + 1
                    वादइत अङ्कः पटम१ अन्तः भवति पटम२ ।   ॰ DIT[sp - 1] = i + 1
                    पस भवति वृसएगसउचच आरभ्य पभ ऽ पइ समाप्तम् ।   ॰ s = seg_succ(v, i)
                    पटम१ भवति ० ।   ॰ if s >= 0 and RPON[s] == -1:
                    यदि पस बृहत्समम् ० आदि   ॰ if s >= 0 and RPON[s] == -1:
                        पटम१ भवति १ ।
                    इति
                    यदि पटम१ समम् १ आदि   ॰ if s >= 0 and RPON[s] == -1:
                        पटम२ भवति वारपओन अङ्कः पस अन्तः ।   ॰ if s >= 0 and RPON[s] == -1:
                        पटम३ भवति ० ।   ॰ if s >= 0 and RPON[s] == -1:
                        यदि पटम२ समम् ऋण१ आदि   ॰ if s >= 0 and RPON[s] == -1:
                            पटम३ भवति १ ।
                        इति
                        पटम१ भवति पटम३ ।
                    इति
                    यदि पटम१ समम् १ आदि   ॰ if s >= 0 and RPON[s] == -1:
                        वारपओन अङ्कः पस अन्तः भवति ऋण२ ।   ॰ RPON[s] = -2
                        वादसतक अङ्कः पसप अन्तः भवति पस ।   ॰ DSTK[sp] = s
                        वादइत अङ्कः पसप अन्तः भवति ० ।   ॰ DIT[sp] = 0
                        पसप भवति पसप योगः १ ।   ॰ sp += 1
                    इति
                इति अन्यथा आदि
                    पसप भवति पसप वियोगः १ ।   ॰ sp -= 1
                    वाबओदय अङ्कः पपओसत अन्तः भवति पभ ।   ॰ BODY[post] = v
                    पपओसत भवति पपओसत योगः १ ।   ॰ post += 1
