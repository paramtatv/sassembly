    व्यर्थम् भवति एकलेखः १२५ ।   ॰ E.o("i64.sub")
    व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ ० समाप्तम् ।   ॰ E.i64c(0)
    व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ ० समाप्तम् ।   ॰ E.lget(0)
    पटम२ भवति रक्षितदैर्घ्यम् योगः ४०९६ ।   ॰ E.i64c(PROT_SIZE + 2 * SPWIN + 7)
    पटम१ भवति पटम२ योगः ७ ।   ॰ E.i64c(PROT_SIZE + 2 * SPWIN + 7)
    व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पटम१ समाप्तम् ।   ॰ E.i64c(PROT_SIZE + 2 * SPWIN + 7)
    व्यर्थम् भवति एकलेखः ८९ ।   ॰ E.o("i64.ge_s")
    व्यर्थम् भवति एकलेखः २७ ।   ॰ E.o("select")
    व्यर्थम् भवति वक्रियाः आरभ्य ३६ ऽ ५५ समाप्तम् ।   ॰ E.gset(G_SPAN)
    व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ ० समाप्तम् ।   ॰ E.i32c(0)
    व्यर्थम् भवति एकलेखः ११ ।   ॰ E.o("end")
    प्रत्यागमनम् ० ।
इति

॰ h_left -> वृहलएफत
वृत्तिः वृहलएफत आदाय अवकाशः ॱॱ अ६४ ददाति अ६४ आदि
    व्यर्थम् भवति वउलेबः ० ।   ॰ E.u(0)
    व्यर्थम् भवति वक्रियाः आरभ्य ३५ ऽ ३१ समाप्तम् ।   ॰ E.gget(G_TOT)
    यदि वाअततएसत समम् ० आदि   ॰ if ATTEST == 0:
        व्यर्थम् भवति वक्रियाः आरभ्य ३५ ऽ ३२ समाप्तम् ।   ॰ E.gget(G_TICKS)
        व्यर्थम् भवति एकलेखः १२४ ।   ॰ E.o("i64.add")
    इति
    व्यर्थम् भवति एकलेखः ११ ।   ॰ E.o("end")
    प्रत्यागमनम् ० ।
इति

॰ h_type -> वृहतयपए
वृत्तिः वृहतयपए आदाय पइ ॱॱ अ६४ ददाति अ६४ आदि
    चरः पत ॱॱ अ६४ भवति ० ।
    पत भवति ६ ।   ॰ t = T_BIN
    यदि पइ समम् ३ आदि   ॰ if i == F_FLUSH:
        पत भवति ८ ।   ॰ t = T_VOID
    इति
    यदि पइ समम् ४ आदि   ॰ if i == F_HALT:
        पत भवति ७ ।   ॰ t = T_HALT
    इति
    यदि पइ समम् ५ आदि   ॰ if i == F_STSLOW:
        पत भवति ४ ।   ॰ t = T_SETUP
    इति
    यदि पइ समम् १५ आदि   ॰ if i == F_GO:
        पत भवति २ ।   ॰ t = T_I32
    इति
    यदि पइ समम् १६ आदि   ॰ if i == F_RUN:
        पत भवति ३ ।   ॰ t = T_RUN
    इति
    यदि पइ समम् १७ आदि   ॰ if i == F_SETUP:
        पत भवति ४ ।   ॰ t = T_SETUP
    इति
    यदि पइ समम् १८ आदि   ॰ if i == F_LEFT:
        पत भवति ५ ।   ॰ t = T_I64
    इति
    प्रत्यागमनम् पत ।   ॰ return t
इति

॰ h_emit -> वृहएमइत
वृत्तिः वृहएमइत आदाय पइ ॱॱ अ६४ ददाति अ६४ आदि
    यदि पइ समम् ३ आदि   ॰ if i == F_FLUSH:
        व्यर्थम् भवति वृहफलउसह ० ।   ॰ h_flush()
    इति
    यदि पइ समम् ४ आदि   ॰ if i == F_HALT:
        व्यर्थम् भवति वृहहअलत ० ।   ॰ h_halt()
    इति
    यदि पइ समम् ५ आदि   ॰ if i == F_STSLOW:
        व्यर्थम् भवति वृहसतसलओव ० ।   ॰ h_stslow()
    इति
    यदि पइ समम् ६ आदि   ॰ if i == F_MULHU:
        व्यर्थम् भवति वृहमउलहउ ० ।   ॰ h_mulhu()
    इति
    यदि पइ समम् ७ आदि   ॰ if i == F_DIV:
        व्यर्थम् भवति वृहदइभओप आरभ्य १ ऽ १ ऽ ० समाप्तम् ।   ॰ h_divop(1, 1, 0)
    इति
    यदि पइ समम् ८ आदि   ॰ if i == F_REM:
        व्यर्थम् भवति वृहदइभओप आरभ्य १ ऽ १ ऽ १ समाप्तम् ।   ॰ h_divop(1, 1, 1)
    इति
    यदि पइ समम् ९ आदि   ॰ if i == F_DIVU:
        व्यर्थम् भवति वृहदइभओप आरभ्य १ ऽ ० ऽ ० समाप्तम् ।   ॰ h_divop(1, 0, 0)
    इति
    यदि पइ समम् १० आदि   ॰ if i == F_REMU:
        व्यर्थम् भवति वृहदइभओप आरभ्य १ ऽ ० ऽ १ समाप्तम् ।   ॰ h_divop(1, 0, 1)
    इति
    यदि पइ समम् ११ आदि   ॰ if i == F_DIVW:
        व्यर्थम् भवति वृहदइभओप आरभ्य ० ऽ १ ऽ ० समाप्तम् ।   ॰ h_divop(0, 1, 0)
    इति
    यदि पइ समम् १२ आदि   ॰ if i == F_REMW:
        व्यर्थम् भवति वृहदइभओप आरभ्य ० ऽ १ ऽ १ समाप्तम् ।   ॰ h_divop(0, 1, 1)
    इति
    यदि पइ समम् १३ आदि   ॰ if i == F_DIVUW:
        व्यर्थम् भवति वृहदइभओप आरभ्य ० ऽ ० ऽ ० समाप्तम् ।   ॰ h_divop(0, 0, 0)
    इति
    यदि पइ समम् १४ आदि   ॰ if i == F_REMUW:
        व्यर्थम् भवति वृहदइभओप आरभ्य ० ऽ ० ऽ १ समाप्तम् ।   ॰ h_divop(0, 0, 1)
    इति
    यदि पइ समम् १५ आदि   ॰ if i == F_GO:
        व्यर्थम् भवति वृहगओ ० ।   ॰ h_go()
    इति
    यदि पइ समम् १६ आदि   ॰ if i == F_RUN:
        व्यर्थम् भवति वृहरउन ० ।   ॰ h_run()
    इति
    यदि पइ समम् १७ आदि   ॰ if i == F_SETUP:
        व्यर्थम् भवति वृहसएतउप ० ।   ॰ h_setup()
    इति
    यदि पइ समम् १८ आदि   ॰ if i == F_LEFT:
        व्यर्थम् भवति वृहलएफत ० ।   ॰ h_left()
    इति
    प्रत्यागमनम् ० ।
इति

॰ writes_x -> वृवरइतएसष
वृत्तिः वृवरइतएसष आदाय पओप ॱॱ अ६४ ददाति अ६४ आदि
    चरः पर ॱॱ अ६४ भवति ० ।
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    पर भवति ० ।   ॰ r = 0
    पटम१ भवति ० ।   ॰ if op >= K_LUI and op <= K_JALR:
    यदि पओप बृहत्समम् १ आदि   ॰ if op >= K_LUI and op <= K_JALR:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if op >= K_LUI and op <= K_JALR:
        पटम२ भवति ० ।   ॰ if op >= K_LUI and op <= K_JALR:
        यदि ४ बृहत्समम् पओप आदि   ॰ if op >= K_LUI and op <= K_JALR:
            पटम२ भवति १ ।
        इति
        पटम१ भवति पटम२ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if op >= K_LUI and op <= K_JALR:
        पर भवति १ ।   ॰ r = 1
    इति
    पटम१ भवति ० ।   ॰ if op >= K_LB and op <= K_LWU:
    यदि पओप बृहत्समम् ११ आदि   ॰ if op >= K_LB and op <= K_LWU:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if op >= K_LB and op <= K_LWU:
        पटम२ भवति ० ।   ॰ if op >= K_LB and op <= K_LWU:
        यदि १७ बृहत्समम् पओप आदि   ॰ if op >= K_LB and op <= K_LWU:
            पटम२ भवति १ ।
        इति
        पटम१ भवति पटम२ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if op >= K_LB and op <= K_LWU:
        पर भवति १ ।   ॰ r = 1
    इति
    पटम१ भवति ० ।   ॰ if op >= K_ADDI and op <= K_REMUW:
    यदि पओप बृहत्समम् २४ आदि   ॰ if op >= K_ADDI and op <= K_REMUW:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if op >= K_ADDI and op <= K_REMUW:
        पटम२ भवति ० ।   ॰ if op >= K_ADDI and op <= K_REMUW:
        यदि ६४ बृहत्समम् पओप आदि   ॰ if op >= K_ADDI and op <= K_REMUW:
            पटम२ भवति १ ।
        इति
        पटम१ भवति पटम२ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if op >= K_ADDI and op <= K_REMUW:
        पर भवति १ ।   ॰ r = 1
    इति
    पटम१ भवति ० ।   ॰ if op == K_CSRS or op == K_SSCR:
    यदि पओप समम् ६६ आदि   ॰ if op == K_CSRS or op == K_SSCR:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् ० आदि   ॰ if op == K_CSRS or op == K_SSCR:
        पटम२ भवति ० ।   ॰ if op == K_CSRS or op == K_SSCR:
        यदि पओप समम् १३४ आदि   ॰ if op == K_CSRS or op == K_SSCR:
            पटम२ भवति १ ।
        इति
        पटम१ भवति पटम२ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if op == K_CSRS or op == K_SSCR:
        पर भवति १ ।   ॰ r = 1
    इति
    प्रत्यागमनम् पर ।   ॰ return r
इति

॰ wasm_plan -> वृवअसमपलअन
वृत्तिः वृवअसमपलअन आदाय अवकाशः ॱॱ अ६४ ददाति अ६४ आदि
    चरः पक ॱॱ अ६४ भवति ० ।
    चरः पओ ॱॱ अ६४ भवति ० ।
    चरः पज ॱॱ अ६४ भवति ० ।
    चरः पए ॱॱ अ६४ भवति ० ।
    चरः पइ ॱॱ अ६४ भवति ० ।
    चरः पओप ॱॱ अ६४ भवति ० ।
    चरः पहइ ॱॱ अ६४ भवति ० ।
    चरः पनषत ॱॱ अ६४ भवति ० ।
    चरः पअचच ॱॱ अ६४ भवति ० ।
    चरः पख ॱॱ अ६४ भवति ० ।
    चरः पत ॱॱ अ६४ भवति ० ।
    चरः पभ ॱॱ अ६४ भवति ० ।
    चरः पवत ॱॱ अ६४ भवति ० ।
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    चरः पटम३ ॱॱ अ६४ भवति ० ।
    चरः पटम४ ॱॱ अ६४ भवति ० ।
    चरः पटम५ ॱॱ अ६४ भवति ० ।
    चरः पटम६ ॱॱ अ६४ भवति ० ।
    चरः पटम७ ॱॱ अ६४ भवति ० ।
    चरः पटम८ ॱॱ अ६४ भवति ० ।
    चरः पटम९ ॱॱ अ६४ भवति ० ।
    चरः पटम१० ॱॱ अ६४ भवति ० ।
    चरः पटम११ ॱॱ अ६४ भवति ० ।
    चरः पटम१२ ॱॱ अ६४ भवति ० ।
    चरः पटम१३ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर१ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर२ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर३ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर४ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर५ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर६ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर७ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर८ ॱॱ अ६४ भवति ० ।
    वाचसरग भवति ० ।   ॰ CSRG = 0
    पक भवति ० ।   ॰ for k in range(NWORDS):
    पस्थिर१ भवति शब्दगणना ।   ॰ for k in range(NWORDS):
    यावत् पक न्यूनम् पस्थिर१ आदि   ॰ for k in range(NWORDS):
        वालएअदएर अङ्कः पक अन्तः भवति ० ।   ॰ LEADER[k] = 0
        वाबलकओफ अङ्कः पक अन्तः भवति ० ।   ॰ BLKOF[k] = 0
        पटम१ भवति क्रियाः अङ्कः पक अन्तः ।   ॰ if OPS[k] == K_SSCR:
        यदि पटम१ समम् १३४ आदि   ॰ if OPS[k] == K_SSCR:
            वाचसरग भवति १ ।   ॰ CSRG = 1
        इति
        पटम१ भवति क्रियाः अङ्कः पक अन्तः ।   ॰ if OPS[k] == K_CSRS and RD[k] != 0:
        पटम२ भवति ० ।   ॰ if OPS[k] == K_CSRS and RD[k] != 0:
        यदि पटम१ समम् ६६ आदि   ॰ if OPS[k] == K_CSRS and RD[k] != 0:
            पटम२ भवति १ ।
        इति
        यदि पटम२ समम् १ आदि   ॰ if OPS[k] == K_CSRS and RD[k] != 0:
            पटम३ भवति लक्ष्याणि अङ्कः पक अन्तः ।   ॰ if OPS[k] == K_CSRS and RD[k] != 0:
            पटम४ भवति ० ।   ॰ if OPS[k] == K_CSRS and RD[k] != 0:
            यदि पटम३ असमम् ० आदि   ॰ if OPS[k] == K_CSRS and RD[k] != 0:
                पटम४ भवति १ ।
            इति
            पटम२ भवति पटम४ ।
        इति
        यदि पटम२ समम् १ आदि   ॰ if OPS[k] == K_CSRS and RD[k] != 0:
            वाचसरग भवति १ ।   ॰ CSRG = 1
        इति
        पटम१ भवति क्रियाः अङ्कः पक अन्तः ।   ॰ if OPS[k] == K_FLD or OPS[k] == K_FSD:
        पटम२ भवति ० ।   ॰ if OPS[k] == K_FLD or OPS[k] == K_FSD:
        यदि पटम१ समम् १८ आदि   ॰ if OPS[k] == K_FLD or OPS[k] == K_FSD:
            पटम२ भवति १ ।
        इति
        यदि पटम२ समम् ० आदि   ॰ if OPS[k] == K_FLD or OPS[k] == K_FSD:
            पटम३ भवति क्रियाः अङ्कः पक अन्तः ।   ॰ if OPS[k] == K_FLD or OPS[k] == K_FSD:
            पटम४ भवति ० ।   ॰ if OPS[k] == K_FLD or OPS[k] == K_FSD:
            यदि पटम३ समम् २३ आदि   ॰ if OPS[k] == K_FLD or OPS[k] == K_FSD:
                पटम४ भवति १ ।
            इति
            पटम२ भवति पटम४ ।
        इति
        यदि पटम२ समम् १ आदि   ॰ if OPS[k] == K_FLD or OPS[k] == K_FSD:
            वाचसरग भवति १ ।   ॰ CSRG = 1
        इति
        पक भवति पक योगः १ ।
    इति
    पटम२ भवति प्रवेशः वियोगः वावगबअसए ।   ॰ LEADER[(ENTRY - WG_BASE) // 4] = 1
