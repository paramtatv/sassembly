    चरः पटम९ ॱॱ अ६४ भवति ० ।
    पओप भवति क्रियाः अङ्कः पक अन्तः ।   ॰ op = OPS[k]
    परद भवति लक्ष्याणि अङ्कः पक अन्तः ।   ॰ rd = RD[k]
    परस१ भवति प्रथमस्रोताः अङ्कः पक अन्तः ।   ॰ rs1 = RS1[k]
    परस२ भवति द्वितीयस्रोताः अङ्कः पक अन्तः ।   ॰ rs2 = RS2[k]
    पइमम भवति मात्राः अङ्कः पक अन्तः ।   ॰ imm = IMM[k]
    यदि परद समम् ० आदि   ॰ if rd == 0:
        प्रत्यागमनम् ० ।   ॰ return 0
    इति
    पटम१ भवति ० ।   ॰ if op == K_ADDI or op == K_XORI or op == K_ORI or op == K_ANDI:
    यदि पओप समम् २४ आदि   ॰ if op == K_ADDI or op == K_XORI or op == K_ORI or op == K_ANDI:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् ० आदि   ॰ if op == K_ADDI or op == K_XORI or op == K_ORI or op == K_ANDI:
        पटम२ भवति ० ।   ॰ if op == K_ADDI or op == K_XORI or op == K_ORI or op == K_ANDI:
        यदि पओप समम् २७ आदि   ॰ if op == K_ADDI or op == K_XORI or op == K_ORI or op == K_ANDI:
            पटम२ भवति १ ।
        इति
        पटम१ भवति पटम२ ।
    इति
    यदि पटम१ समम् ० आदि   ॰ if op == K_ADDI or op == K_XORI or op == K_ORI or op == K_ANDI:
        पटम३ भवति ० ।   ॰ if op == K_ADDI or op == K_XORI or op == K_ORI or op == K_ANDI:
        यदि पओप समम् २८ आदि   ॰ if op == K_ADDI or op == K_XORI or op == K_ORI or op == K_ANDI:
            पटम३ भवति १ ।
        इति
        पटम१ भवति पटम३ ।
    इति
    यदि पटम१ समम् ० आदि   ॰ if op == K_ADDI or op == K_XORI or op == K_ORI or op == K_ANDI:
        पटम४ भवति ० ।   ॰ if op == K_ADDI or op == K_XORI or op == K_ORI or op == K_ANDI:
        यदि पओप समम् २९ आदि   ॰ if op == K_ADDI or op == K_XORI or op == K_ORI or op == K_ANDI:
            पटम४ भवति १ ।
        इति
        पटम१ भवति पटम४ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if op == K_ADDI or op == K_XORI or op == K_ORI or op == K_ANDI:
        पटम१ भवति ० ।   ॰ if rs1 == 0 and op == K_ADDI:
        यदि परस१ समम् ० आदि   ॰ if rs1 == 0 and op == K_ADDI:
            पटम१ भवति १ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if rs1 == 0 and op == K_ADDI:
            पटम२ भवति ० ।   ॰ if rs1 == 0 and op == K_ADDI:
            यदि पओप समम् २४ आदि   ॰ if rs1 == 0 and op == K_ADDI:
                पटम२ भवति १ ।
            इति
            पटम१ भवति पटम२ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if rs1 == 0 and op == K_ADDI:
            व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पइमम समाप्तम् ।   ॰ E.i64c(imm)
        इति अन्यथा आदि
            व्यर्थम् भवति वृरगएत परस१ ।   ॰ rget(rs1)
            व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पइमम समाप्तम् ।   ॰ E.i64c(imm)
            पच भवति १२४ ।   ॰ c = I64_ADD
            यदि पओप समम् २७ आदि   ॰ if op == K_XORI:
                पच भवति १३३ ।   ॰ c = I64_XOR
            इति
            यदि पओप समम् २८ आदि   ॰ if op == K_ORI:
                पच भवति १३२ ।   ॰ c = I64_OR
            इति
            यदि पओप समम् २९ आदि   ॰ if op == K_ANDI:
                पच भवति १३१ ।   ॰ c = I64_AND
            इति
            व्यर्थम् भवति एकलेखः पच ।   ॰ E.byte(c)
        इति
        व्यर्थम् भवति वृरपउत परद ।   ॰ rput(rd)
    इति
    पटम१ भवति ० ।   ॰ if op == K_SLTI or op == K_SLTIU:
    यदि पओप समम् २५ आदि   ॰ if op == K_SLTI or op == K_SLTIU:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् ० आदि   ॰ if op == K_SLTI or op == K_SLTIU:
        पटम२ भवति ० ।   ॰ if op == K_SLTI or op == K_SLTIU:
        यदि पओप समम् २६ आदि   ॰ if op == K_SLTI or op == K_SLTIU:
            पटम२ भवति १ ।
        इति
        पटम१ भवति पटम२ ।
