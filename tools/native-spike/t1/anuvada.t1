        व्यर्थम् भवति वउलेबः पटम१ ।   ॰ E.u(h_type(i))
        पइ भवति पइ योगः १ ।
    इति
    पइ भवति ० ।   ॰ for i in range(NSEG):
    पस्थिर२ भवति वानसएग ।   ॰ for i in range(NSEG):
    यावत् पइ न्यूनम् पस्थिर२ आदि   ॰ for i in range(NSEG):
        व्यर्थम् भवति वउलेबः २ ।   ॰ E.u(T_I32)
        पइ भवति पइ योगः १ ।
    इति
    व्यर्थम् भवति वृएनदबओदय पपओस ।   ॰ end_body(pos)
    पपओस भवति वृसएचबएगइन ४ ।   ॰ pos = sec_begin(4)
    व्यर्थम् भवति वउलेबः १ ।   ॰ E.u(1)
    व्यर्थम् भवति एकलेखः ११२ ।   ॰ E.byte(0x70)
    व्यर्थम् भवति एकलेखः ० ।   ॰ E.byte(0)
    व्यर्थम् भवति वउलेबः वानसएग ।   ॰ E.u(NSEG)
    व्यर्थम् भवति वृएनदबओदय पपओस ।   ॰ end_body(pos)
    पपओस भवति वृसएचबएगइन ५ ।   ॰ pos = sec_begin(5)
    व्यर्थम् भवति वउलेबः १ ।   ॰ E.u(1)
    व्यर्थम् भवति एकलेखः १ ।   ॰ E.byte(1)
    पटम३ भवति वारअमओफफ योगः बिम्बदैर्घ्यम् ।   ॰ E.u((RAMOFF + IMGLEN + 0xFFFF) // 0x10000)
    पटम२ भवति पटम३ योगः ६५५३५ ।   ॰ E.u((RAMOFF + IMGLEN + 0xFFFF) // 0x10000)
    पटम१ भवति पटम२ विभाजनम् ६५५३६ ।   ॰ E.u((RAMOFF + IMGLEN + 0xFFFF) // 0x10000)
    व्यर्थम् भवति वउलेबः पटम१ ।   ॰ E.u((RAMOFF + IMGLEN + 0xFFFF) // 0x10000)
    व्यर्थम् भवति वउलेबः ६५५३६ ।   ॰ E.u(65536)
    व्यर्थम् भवति वृएनदबओदय पपओस ।   ॰ end_body(pos)
    व्यर्थम् भवति वृसएचगलओबअलस पअततएसत ।   ॰ sec_globals(attest)
    व्यर्थम् भवति वृसएचएषपओरतस ० ।   ॰ sec_exports()
    पपओस भवति वृसएचबएगइन ९ ।   ॰ pos = sec_begin(9)
    व्यर्थम् भवति वउलेबः १ ।   ॰ E.u(1)
    व्यर्थम् भवति एकलेखः ० ।   ॰ E.byte(0)
    व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ ० समाप्तम् ।   ॰ E.i32c(0)
    व्यर्थम् भवति एकलेखः ११ ।   ॰ E.o("end")
    व्यर्थम् भवति वउलेबः वानसएग ।   ॰ E.u(NSEG)
    पइ भवति ० ।   ॰ for i in range(NSEG):
    पस्थिर३ भवति वानसएग ।   ॰ for i in range(NSEG):
    यावत् पइ न्यूनम् पस्थिर३ आदि   ॰ for i in range(NSEG):
        पटम१ भवति १९ योगः पइ ।   ॰ E.u(F_SEG0 + i)
        व्यर्थम् भवति वउलेबः पटम१ ।   ॰ E.u(F_SEG0 + i)
        पइ भवति पइ योगः १ ।
    इति
    व्यर्थम् भवति वृएनदबओदय पपओस ।   ॰ end_body(pos)
    पपओस भवति वृसएचबएगइन १० ।   ॰ pos = sec_begin(10)
    पटम१ भवति १६ योगः वानसएग ।   ॰ E.u(16 + NSEG)
    व्यर्थम् भवति वउलेबः पटम१ ।   ॰ E.u(16 + NSEG)
    पइ भवति ३ ।   ॰ for i in range(F_FLUSH, F_LEFT + 1):
    पस्थिर४ भवति १९ ।   ॰ for i in range(F_FLUSH, F_LEFT + 1):
    यावत् पइ न्यूनम् पस्थिर४ आदि   ॰ for i in range(F_FLUSH, F_LEFT + 1):
        पप२ भवति वृबएगइनबओदय ० ।   ॰ p2 = begin_body()
        व्यर्थम् भवति वृहएमइत पइ ।   ॰ h_emit(i)
        व्यर्थम् भवति वृएनदबओदय पप२ ।   ॰ end_body(p2)
        पइ भवति पइ योगः १ ।
    इति
    पइ भवति ० ।   ॰ for i in range(NSEG):
    पस्थिर५ भवति वानसएग ।   ॰ for i in range(NSEG):
    यावत् पइ न्यूनम् पस्थिर५ आदि   ॰ for i in range(NSEG):
        व्यर्थम् भवति वृसएगफउनच पइ ।   ॰ seg_func(i)
        पइ भवति पइ योगः १ ।
    इति
    व्यर्थम् भवति वृएनदबओदय पपओस ।   ॰ end_body(pos)
    व्यर्थम् भवति वृसएचदअतअ ० ।   ॰ sec_data()
    प्रत्यागमनम् ० ।   ॰ return 0
इति

॰ wasm_sizes -> वृवअसमसइशएस
वृत्तिः वृवअसमसइशएस आदाय अवकाशः ॱॱ अ६४ ददाति अ६४ आदि
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    पटम१ भवति शब्दगणना वियोगः १ ।   ॰ grow(LEADER, NWORDS)
    वालएअदएर अङ्कः पटम१ अन्तः भवति ० ।   ॰ grow(LEADER, NWORDS)
    पटम१ भवति शब्दगणना वियोगः १ ।   ॰ grow(BLKOF, NWORDS)
    वाबलकओफ अङ्कः पटम१ अन्तः भवति ० ।   ॰ grow(BLKOF, NWORDS)
    पटम१ भवति शब्दगणना वियोगः १ ।   ॰ grow(STARTS, NWORDS)
    वासतअरतस अङ्कः पटम१ अन्तः भवति ० ।   ॰ grow(STARTS, NWORDS)
    पटम१ भवति शब्दगणना वियोगः १ ।   ॰ grow(BLEN, NWORDS)
    वाबलएन अङ्कः पटम१ अन्तः भवति ० ।   ॰ grow(BLEN, NWORDS)
    पटम१ भवति शब्दगणना वियोगः १ ।   ॰ grow(SEGA, NWORDS)
    वासएगअ अङ्कः पटम१ अन्तः भवति ० ।   ॰ grow(SEGA, NWORDS)
    पटम१ भवति शब्दगणना वियोगः १ ।   ॰ grow(SEGB, NWORDS)
    वासएगब अङ्कः पटम१ अन्तः भवति ० ।   ॰ grow(SEGB, NWORDS)
    पटम१ भवति शब्दगणना वियोगः १ ।   ॰ grow(SEGOF, NWORDS)
    वासएगओफ अङ्कः पटम१ अन्तः भवति ० ।   ॰ grow(SEGOF, NWORDS)
    प्रत्यागमनम् ० ।
इति

॰ wasm_entry -> वृवअसमएनतरय
वृत्तिः वृवअसमएनतरय आदाय अवकाशः ॱॱ अ६४ ददाति अ६४ आदि
