    चरः पटम१० ॱॱ अ६४ भवति ० ।
    चरः पटम११ ॱॱ अ६४ भवति ० ।
    पओप भवति क्रियाः अङ्कः पक अन्तः ।   ॰ op = OPS[k]
    परद भवति लक्ष्याणि अङ्कः पक अन्तः ।   ॰ rd = RD[k]
    पवद भवति ८ ।   ॰ wd = 8
    पलद भवति ४१ ।   ॰ ld = 0x29
    यदि पओप समम् ११ आदि   ॰ if op == K_LB:
        पवद भवति १ ।   ॰ wd = 1
        पलद भवति ४८ ।   ॰ ld = 0x30
    इति
    यदि पओप समम् १५ आदि   ॰ if op == K_LBU:
        पवद भवति १ ।   ॰ wd = 1
        पलद भवति ४९ ।   ॰ ld = 0x31
    इति
    यदि पओप समम् १२ आदि   ॰ if op == K_LH:
        पवद भवति २ ।   ॰ wd = 2
        पलद भवति ५० ।   ॰ ld = 0x32
    इति
    यदि पओप समम् १६ आदि   ॰ if op == K_LHU:
        पवद भवति २ ।   ॰ wd = 2
        पलद भवति ५१ ।   ॰ ld = 0x33
    इति
    यदि पओप समम् १३ आदि   ॰ if op == K_LW:
        पवद भवति ४ ।   ॰ wd = 4
        पलद भवति ५२ ।   ॰ ld = 0x34
    इति
    यदि पओप समम् १७ आदि   ॰ if op == K_LWU:
        पवद भवति ४ ।   ॰ wd = 4
        पलद भवति ५३ ।   ॰ ld = 0x35
    इति
    पटम१ भवति ० ।   ॰ if FASTM and RS1[k] == 2:
    यदि वाफअसतम असमम् ० आदि   ॰ if FASTM and RS1[k] == 2:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if FASTM and RS1[k] == 2:
        पटम२ भवति प्रथमस्रोताः अङ्कः पक अन्तः ।   ॰ if FASTM and RS1[k] == 2:
        पटम३ भवति ० ।   ॰ if FASTM and RS1[k] == 2:
        यदि पटम२ समम् २ आदि   ॰ if FASTM and RS1[k] == 2:
            पटम३ भवति १ ।
        इति
        पटम१ भवति पटम३ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if FASTM and RS1[k] == 2:
        पटम२ भवति मात्राः अङ्कः पक अन्तः ।   ॰ si = (IMM[k] + 2048) // 8
        पटम१ भवति पटम२ योगः २०४८ ।   ॰ si = (IMM[k] + 2048) // 8
        पसइ भवति पटम१ विभाजनम् ८ ।   ॰ si = (IMM[k] + 2048) // 8
        पटम१ भवति ० ।   ॰ if op == K_LD and (IMM[k] + 2048) % 8 == 0 and SLOTG[si] == GEN and RE
        यदि पओप समम् १४ आदि   ॰ if op == K_LD and (IMM[k] + 2048) % 8 == 0 and SLOTG[si] == GEN and RE
            पटम१ भवति १ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if op == K_LD and (IMM[k] + 2048) % 8 == 0 and SLOTG[si] == GEN and RE
            पटम४ भवति मात्राः अङ्कः पक अन्तः ।   ॰ if op == K_LD and (IMM[k] + 2048) % 8 == 0 and SLOTG[si] == GEN and RE
            पटम३ भवति पटम४ योगः २०४८ ।   ॰ if op == K_LD and (IMM[k] + 2048) % 8 == 0 and SLOTG[si] == GEN and RE
            पटम२ भवति पटम३ शेषः ८ ।   ॰ if op == K_LD and (IMM[k] + 2048) % 8 == 0 and SLOTG[si] == GEN and RE
            पटम५ भवति ० ।   ॰ if op == K_LD and (IMM[k] + 2048) % 8 == 0 and SLOTG[si] == GEN and RE
            यदि पटम२ समम् ० आदि   ॰ if op == K_LD and (IMM[k] + 2048) % 8 == 0 and SLOTG[si] == GEN and RE
                पटम५ भवति १ ।
            इति
            पटम१ भवति पटम५ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if op == K_LD and (IMM[k] + 2048) % 8 == 0 and SLOTG[si] == GEN and RE
            पटम६ भवति वासलओतग अङ्कः पसइ अन्तः ।   ॰ if op == K_LD and (IMM[k] + 2048) % 8 == 0 and SLOTG[si] == GEN and RE
            पटम७ भवति ० ।   ॰ if op == K_LD and (IMM[k] + 2048) % 8 == 0 and SLOTG[si] == GEN and RE
            यदि पटम६ समम् वागएन आदि   ॰ if op == K_LD and (IMM[k] + 2048) % 8 == 0 and SLOTG[si] == GEN and RE
                पटम७ भवति १ ।
            इति
            पटम१ भवति पटम७ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if op == K_LD and (IMM[k] + 2048) % 8 == 0 and SLOTG[si] == GEN and RE
            पटम९ भवति वासलओतर अङ्कः पसइ अन्तः ।   ॰ if op == K_LD and (IMM[k] + 2048) % 8 == 0 and SLOTG[si] == GEN and RE
            पटम८ भवति वारएगभएर अङ्कः पटम९ अन्तः ।   ॰ if op == K_LD and (IMM[k] + 2048) % 8 == 0 and SLOTG[si] == GEN and RE
            पटम१० भवति वासलओतभ अङ्कः पसइ अन्तः ।   ॰ if op == K_LD and (IMM[k] + 2048) % 8 == 0 and SLOTG[si] == GEN and RE
            पटम११ भवति ० ।   ॰ if op == K_LD and (IMM[k] + 2048) % 8 == 0 and SLOTG[si] == GEN and RE
            यदि पटम८ समम् पटम१० आदि   ॰ if op == K_LD and (IMM[k] + 2048) % 8 == 0 and SLOTG[si] == GEN and RE
                पटम११ भवति १ ।
            इति
            पटम१ भवति पटम११ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if op == K_LD and (IMM[k] + 2048) % 8 == 0 and SLOTG[si] == GEN and RE
