    प्रत्यागमनम् ० ।
इति

॰ slot_forget -> वृसलओतफओरगएत
वृत्तिः वृसलओतफओरगएत आदाय पओफफ ॱॱ अ६४ ऽ पवद ॱॱ अ६४ ददाति अ६४ आदि
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    चरः पटम३ ॱॱ अ६४ भवति ० ।
    चरः पटम४ ॱॱ अ६४ भवति ० ।
    पटम२ भवति पओफफ योगः २०४८ ।   ॰ SLOTG[(off + 2048) // 8] = -1
    पटम१ भवति पटम२ विभाजनम् ८ ।   ॰ SLOTG[(off + 2048) // 8] = -1
    वासलओतग अङ्कः पटम१ अन्तः भवति ऋण१ ।   ॰ SLOTG[(off + 2048) // 8] = -1
    पटम४ भवति पओफफ योगः २०४८ ।   ॰ SLOTG[(off + 2048 + wd - 1) // 8] = -1
    पटम३ भवति पटम४ योगः पवद ।   ॰ SLOTG[(off + 2048 + wd - 1) // 8] = -1
    पटम२ भवति पटम३ वियोगः १ ।   ॰ SLOTG[(off + 2048 + wd - 1) // 8] = -1
    पटम१ भवति पटम२ विभाजनम् ८ ।   ॰ SLOTG[(off + 2048 + wd - 1) // 8] = -1
    वासलओतग अङ्कः पटम१ अन्तः भवति ऋण१ ।   ॰ SLOTG[(off + 2048 + wd - 1) // 8] = -1
    प्रत्यागमनम् ० ।
इति

॰ child_of -> वृचहइलदओफ
वृत्तिः वृचहइलदओफ आदाय पह ॱॱ अ६४ ऽ पज ॱॱ अ६४ ददाति अ६४ आदि
    चरः पष ॱॱ अ६४ भवति ० ।
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पस्थिर१ ॱॱ अ६४ भवति ० ।
    पष भवति पज ।   ॰ x = j
    पटम१ भवति वालएनद अङ्कः पज अन्तः ।   ॰ if LEND[j] < 0:
    यदि पटम१ न्यूनम् ० आदि   ॰ if LEND[j] < 0:
        पष भवति वाइननएर अङ्कः पज अन्तः ।   ॰ x = INNER[j]
        यदि पष समम् पह आदि   ॰ if x == h:
            प्रत्यागमनम् पज ।   ॰ return j
        इति
    इति
    पस्थिर१ भवति १ ।   ॰ while LPAR[x] != h:
    यावत् पस्थिर१ समम् १ आदि   ॰ while LPAR[x] != h:
        पटम१ भवति वालपअर अङ्कः पष अन्तः ।   ॰ while LPAR[x] != h:
        पस्थिर१ भवति ० ।
        यदि पटम१ असमम् पह आदि
            पस्थिर१ भवति १ ।
        इति
        यदि पस्थिर१ समम् १ आदि
            पष भवति वालपअर अङ्कः पष अन्तः ।   ॰ x = LPAR[x]
        इति
    इति
    प्रत्यागमनम् पष ।   ॰ return x
इति

॰ block_target -> वृबलओचकतअरगएत
वृत्तिः वृबलओचकतअरगएत आदाय पप ॱॱ अ६४ ददाति अ६४ आदि
    चरः पक ॱॱ अ६४ भवति ० ।
    चरः पओप ॱॱ अ६४ भवति ० ।
    चरः पर ॱॱ अ६४ भवति ० ।
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    चरः पटम३ ॱॱ अ६४ भवति ० ।
    वातहरएअदष भवति ० ।   ॰ THREADX = 0
    पटम२ भवति वासतअरतस अङ्कः पप अन्तः ।   ॰ k = STARTS[p] + BLEN[p] - 1
    पटम३ भवति वाबलएन अङ्कः पप अन्तः ।   ॰ k = STARTS[p] + BLEN[p] - 1
    पटम१ भवति पटम२ योगः पटम३ ।   ॰ k = STARTS[p] + BLEN[p] - 1
    पक भवति पटम१ वियोगः १ ।   ॰ k = STARTS[p] + BLEN[p] - 1
    पओप भवति क्रियाः अङ्कः पक अन्तः ।   ॰ op = OPS[k]
    पर भवति ऋण१ ।   ॰ r = -1
    पटम१ भवति ० ।   ॰ if op == K_JAL or (op >= K_BEQ and op <= K_BGEU):
    यदि पओप समम् ३ आदि   ॰ if op == K_JAL or (op >= K_BEQ and op <= K_BGEU):
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् ० आदि   ॰ if op == K_JAL or (op >= K_BEQ and op <= K_BGEU):
        पटम२ भवति ० ।   ॰ if op == K_JAL or (op >= K_BEQ and op <= K_BGEU):
        यदि पओप बृहत्समम् ५ आदि   ॰ if op == K_JAL or (op >= K_BEQ and op <= K_BGEU):
            पटम२ भवति १ ।
        इति
        यदि पटम२ समम् १ आदि   ॰ if op == K_JAL or (op >= K_BEQ and op <= K_BGEU):
            पटम३ भवति ० ।   ॰ if op == K_JAL or (op >= K_BEQ and op <= K_BGEU):
            यदि १० बृहत्समम् पओप आदि   ॰ if op == K_JAL or (op >= K_BEQ and op <= K_BGEU):
                पटम३ भवति १ ।
            इति
            पटम२ भवति पटम३ ।
        इति
        पटम१ भवति पटम२ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if op == K_JAL or (op >= K_BEQ and op <= K_BGEU):
        पटम२ भवति ४ गुणनम् पक ।   ॰ r = direct_target(WG_BASE + 4 * k, IMM[k])
        पटम१ भवति वावगबअसए योगः पटम२ ।   ॰ r = direct_target(WG_BASE + 4 * k, IMM[k])
        पटम३ भवति मात्राः अङ्कः पक अन्तः ।   ॰ r = direct_target(WG_BASE + 4 * k, IMM[k])
        पर भवति वृदइरएचततअरगएत आरभ्य पटम१ ऽ पटम३ समाप्तम् ।   ॰ r = direct_target(WG_BASE + 4 * k, IMM[k])
        यदि पर बृहत्समम् ० आदि   ॰ if r >= 0:
            पर भवति वृतहरएअद पर ।   ॰ r = thread(r)
        इति
    इति
    प्रत्यागमनम् पर ।   ॰ return r
इति

॰ lower_ctl -> वृलओवएरचतल
वृत्तिः वृलओवएरचतल आदाय पक ॱॱ अ६४ ऽ पपच ॱॱ अ६४ ऽ परएफउनद ॱॱ अ६४ ददाति अ६४ आदि
    चरः पओप ॱॱ अ६४ भवति ० ।
    चरः परद ॱॱ अ६४ भवति ० ।
    चरः परस१ ॱॱ अ६४ भवति ० ।
    चरः परस२ ॱॱ अ६४ भवति ० ।
    चरः पइमम ॱॱ अ६४ भवति ० ।
    चरः पतब ॱॱ अ६४ भवति ० ।
    चरः पच ॱॱ अ६४ भवति ० ।
    चरः पटम१ ॱॱ अ६४ भवति ० ।
    चरः पटम२ ॱॱ अ६४ भवति ० ।
    पओप भवति क्रियाः अङ्कः पक अन्तः ।   ॰ op = OPS[k]
    परद भवति लक्ष्याणि अङ्कः पक अन्तः ।   ॰ rd = RD[k]
    परस१ भवति प्रथमस्रोताः अङ्कः पक अन्तः ।   ॰ rs1 = RS1[k]
    परस२ भवति द्वितीयस्रोताः अङ्कः पक अन्तः ।   ॰ rs2 = RS2[k]
    पइमम भवति मात्राः अङ्कः पक अन्तः ।   ॰ imm = IMM[k]
    यदि पओप समम् १ आदि   ॰ if op == K_LUI:
        पटम१ भवति ० ।   ॰ if rd:
        यदि परद असमम् ० आदि   ॰ if rd:
            पटम१ भवति १ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if rd:
            व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पइमम समाप्तम् ।   ॰ E.i64c(imm)
            व्यर्थम् भवति वृरपउत परद ।   ॰ rput(rd)
        इति
    इति
    यदि पओप समम् २ आदि   ॰ if op == K_AUIPC:
        पटम१ भवति ० ।   ॰ if rd:
        यदि परद असमम् ० आदि   ॰ if rd:
            पटम१ भवति १ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if rd:
            पटम१ भवति पपच योगः पइमम ।   ॰ E.i64c(pc + imm)
            व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पटम१ समाप्तम् ।   ॰ E.i64c(pc + imm)
            व्यर्थम् भवति वृरपउत परद ।   ॰ rput(rd)
        इति
    इति
    यदि पओप समम् ३ आदि   ॰ if op == K_JAL:
        पटम१ भवति ० ।   ॰ if rd:
        यदि परद असमम् ० आदि   ॰ if rd:
            पटम१ भवति १ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if rd:
            पटम१ भवति पपच योगः ४ ।   ॰ E.i64c(pc + 4)
            व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पटम१ समाप्तम् ।   ॰ E.i64c(pc + 4)
            व्यर्थम् भवति वृरपउत परद ।   ॰ rput(rd)
        इति
        पतब भवति वृदइरएचततअरगएत आरभ्य पपच ऽ पइमम समाप्तम् ।   ॰ tb = direct_target(pc, imm)
        यदि पइमम समम् ० आदि   ॰ if imm == 0:
            व्यर्थम् भवति वृफअउलत आरभ्य १६ ऽ पपच ऽ ० ऽ ० ऽ ० ऽ ० ऽ परएफउनद समाप्तम् ।   ॰ fault(16, pc, 0, 0, 0, 0, refund)
        इति अन्यथा आदि
            यदि पतब बृहत्समम् ० आदि   ॰ elif tb >= 0:
                पटम१ भवति ० ।   ॰ if FASTM and rd == 2:
                यदि वाफअसतम असमम् ० आदि   ॰ if FASTM and rd == 2:
                    पटम१ भवति १ ।
                इति
                यदि पटम१ समम् १ आदि   ॰ if FASTM and rd == 2:
                    पटम२ भवति ० ।   ॰ if FASTM and rd == 2:
                    यदि परद समम् २ आदि   ॰ if FASTM and rd == 2:
                        पटम२ भवति १ ।
                    इति
                    पटम१ भवति पटम२ ।
                इति
                यदि पटम१ समम् १ आदि   ॰ if FASTM and rd == 2:
                    व्यर्थम् भवति वृवइनएषइत पतब ।   ॰ win_exit(tb)
                इति
                व्यर्थम् भवति वृगओतओबलक पतब ।   ॰ goto_blk(tb)
            इति अन्यथा आदि
                पटम१ भवति पपच योगः पइमम ।   ॰ fault(8, pc, 0, pc + imm, 0, 0, refund)
                व्यर्थम् भवति वृफअउलत आरभ्य ८ ऽ पपच ऽ ० ऽ पटम१ ऽ ० ऽ ० ऽ परएफउनद समाप्तम् ।   ॰ fault(8, pc, 0, pc + imm, 0, 0, refund)
            इति
        इति
    इति
    यदि पओप समम् ४ आदि   ॰ if op == K_JALR:
        व्यर्थम् भवति वृरगएत परस१ ।   ॰ rget(rs1)
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पइमम समाप्तम् ।   ॰ E.i64c(imm)
        व्यर्थम् भवति एकलेखः १२४ ।   ॰ E.o("i64.add")
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ ऋण२ समाप्तम् ।   ॰ E.i64c(-2)
        व्यर्थम् भवति एकलेखः १३१ ।   ॰ E.o("i64.and")
        व्यर्थम् भवति वक्रियाः आरभ्य ३३ ऽ ३६ समाप्तम् ।   ॰ E.lset(LOC_T)
        पटम१ भवति ० ।   ॰ if rd:
        यदि परद असमम् ० आदि   ॰ if rd:
            पटम१ भवति १ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if rd:
            पटम१ भवति पपच योगः ४ ।   ॰ E.i64c(pc + 4)
            व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ पटम१ समाप्तम् ।   ॰ E.i64c(pc + 4)
            व्यर्थम् भवति वृरपउत परद ।   ॰ rput(rd)
        इति
        व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ ३६ समाप्तम् ।   ॰ E.lget(LOC_T)
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ वावगबअसए समाप्तम् ।   ॰ E.i64c(WG_BASE)
        व्यर्थम् भवति एकलेखः १२५ ।   ॰ E.o("i64.sub")
        व्यर्थम् भवति वक्रियाः आरभ्य ३४ ऽ ३४ समाप्तम् ।   ॰ E.ltee(LOC_OFF)
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६६ ऽ सङ्केतदैर्घ्यम् समाप्तम् ।   ॰ E.i64c(CODE_SIZE)
        व्यर्थम् भवति एकलेखः ९० ।   ॰ E.o("i64.ge_u")
        व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ ३४ समाप्तम् ।   ॰ E.lget(LOC_OFF)
        व्यर्थम् भवति एकलेखः १६७ ।   ॰ E.o("i32.wrap_i64")
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ ३ समाप्तम् ।   ॰ E.i32c(3)
        व्यर्थम् भवति अक्षरलेखः वर्णाष्टकम् जखजगकङङक इति ।
        वाचतषनएसत भवति १ ।   ॰ CTXNEST = 1
        व्यर्थम् भवति वृफअउलत आरभ्य ८ ऽ पपच ऽ १ ऽ ३६ ऽ ० ऽ ० ऽ परएफउनद समाप्तम् ।   ॰ fault(8, pc, 1, LOC_T, 0, 0, refund)
        वाचतषनएसत भवति ० ।   ॰ CTXNEST = 0
        व्यर्थम् भवति एकलेखः ११ ।   ॰ E.o("end")
        व्यर्थम् भवति वक्रियाः आरभ्य ३२ ऽ ३४ समाप्तम् ।   ॰ E.lget(LOC_OFF)
        व्यर्थम् भवति एकलेखः १६७ ।   ॰ E.o("i32.wrap_i64")
        व्यर्थम् भवति वस्मृतिः आरभ्य ४० ऽ २ ऽ ६५७९२ समाप्तम् ।   ॰ E.mem("i32.load", WL_JT)
        व्यर्थम् भवति वक्रियाः आरभ्य ३४ ऽ ३७ समाप्तम् ।   ॰ E.ltee(LOC_BLK)
        व्यर्थम् भवति वसङ्ख्या आरभ्य ६५ ऽ ० समाप्तम् ।   ॰ E.i32c(0)
        व्यर्थम् भवति अक्षरलेखः वर्णाष्टकम् ङझकङङक इति ।
        वाचतषनएसत भवति १ ।   ॰ CTXNEST = 1
        व्यर्थम् भवति वृफअउलत आरभ्य ११ ऽ पपच ऽ १ ऽ ३६ ऽ ० ऽ ० ऽ परएफउनद समाप्तम् ।   ॰ fault(11, pc, 1, LOC_T, 0, 0, refund)
        वाचतषनएसत भवति ० ।   ॰ CTXNEST = 0
        व्यर्थम् भवति एकलेखः ११ ।   ॰ E.o("end")
        पटम१ भवति ० ।   ॰ if FASTM and rd == 2:
        यदि वाफअसतम असमम् ० आदि   ॰ if FASTM and rd == 2:
            पटम१ भवति १ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if FASTM and rd == 2:
            पटम२ भवति ० ।   ॰ if FASTM and rd == 2:
            यदि परद समम् २ आदि   ॰ if FASTM and rd == 2:
                पटम२ भवति १ ।
            इति
            पटम१ भवति पटम२ ।
        इति
        यदि पटम१ समम् १ आदि   ॰ if FASTM and rd == 2:
            व्यर्थम् भवति वृवइनएषइत ऋण१ ।   ॰ win_exit(-1)
        इति
        पटम२ भवति वाचतषचनत योगः वाचतषनएसत ।   ॰ E.br(CTXCNT + CTXNEST + DISPOFF)
        पटम१ भवति पटम२ योगः वादइसपओफफ ।   ॰ E.br(CTXCNT + CTXNEST + DISPOFF)
        व्यर्थम् भवति वक्रियाः आरभ्य १२ ऽ पटम१ समाप्तम् ।   ॰ E.br(CTXCNT + CTXNEST + DISPOFF)
    इति
    पटम१ भवति ० ।   ॰ if op >= K_BEQ and op <= K_BGEU:
    यदि पओप बृहत्समम् ५ आदि   ॰ if op >= K_BEQ and op <= K_BGEU:
        पटम१ भवति १ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if op >= K_BEQ and op <= K_BGEU:
        पटम२ भवति ० ।   ॰ if op >= K_BEQ and op <= K_BGEU:
        यदि १० बृहत्समम् पओप आदि   ॰ if op >= K_BEQ and op <= K_BGEU:
            पटम२ भवति १ ।
        इति
        पटम१ भवति पटम२ ।
    इति
    यदि पटम१ समम् १ आदि   ॰ if op >= K_BEQ and op <= K_BGEU:
        व्यर्थम् भवति वृरगएत परस१ ।   ॰ rget(rs1)
        व्यर्थम् भवति वृरगएत परस२ ।   ॰ rget(rs2)
        पच भवति ८१ ।   ॰ c = I64_EQ
        यदि पओप समम् ६ आदि   ॰ if op == K_BNE:
            पच भवति ८२ ।   ॰ c = I64_NE
        इति
        यदि पओप समम् ७ आदि   ॰ if op == K_BLT:
            पच भवति ८३ ।   ॰ c = I64_LT_S
        इति
        यदि पओप समम् ८ आदि   ॰ if op == K_BGE:
            पच भवति ८९ ।   ॰ c = I64_GE_S
        इति
        यदि पओप समम् ९ आदि   ॰ if op == K_BLTU:
            पच भवति ८४ ।   ॰ c = I64_LT_U
        इति
        यदि पओप समम् १० आदि   ॰ if op == K_BGEU:
            पच भवति ९० ।   ॰ c = I64_GE_U
        इति
        व्यर्थम् भवति एकलेखः पच ।   ॰ E.byte(c)
        व्यर्थम् भवति एकलेखः ४ ।   ॰ E.blk("if")
        व्यर्थम् भवति एकलेखः ६४ ।   ॰ E.blk("if")
        वाचतषनएसत भवति १ ।   ॰ CTXNEST = 1
        पतब भवति वृदइरएचततअरगएत आरभ्य पपच ऽ पइमम समाप्तम् ।   ॰ tb = direct_target(pc, imm)
        यदि पतब बृहत्समम् ० आदि   ॰ if tb >= 0:
            व्यर्थम् भवति वृगओतओबलक पतब ।   ॰ goto_blk(tb)
        इति अन्यथा आदि
            पटम१ भवति पपच योगः पइमम ।   ॰ fault(8, pc, 0, pc + imm, 0, 0, refund)
            व्यर्थम् भवति वृफअउलत आरभ्य ८ ऽ पपच ऽ ० ऽ पटम१ ऽ ० ऽ ० ऽ परएफउनद समाप्तम् ।   ॰ fault(8, pc, 0, pc + imm, 0, 0, refund)
        इति
        वाचतषनएसत भवति ० ।   ॰ CTXNEST = 0
        व्यर्थम् भवति एकलेखः ११ ।   ॰ E.o("end")
    इति
    प्रत्यागमनम् ० ।
इति

॰ lim_index -> वृलइमइनदएष
वृत्तिः वृलइमइनदएष आदाय पवद ॱॱ अ६४ ददाति अ६४ आदि
    चरः पर ॱॱ अ६४ भवति ० ।
    पर भवति ० ।   ॰ r = 0
    यदि पवद समम् २ आदि   ॰ if wd == 2:
        पर भवति १ ।   ॰ r = 1
    इति
    यदि पवद समम् ४ आदि   ॰ if wd == 4:
        पर भवति २ ।   ॰ r = 2
    इति
    यदि पवद समम् ८ आदि   ॰ if wd == 8:
        पर भवति ३ ।   ॰ r = 3
    इति
    प्रत्यागमनम् पर ।   ॰ return r
इति

॰ wd_align -> वृवदअलइगन
वृत्तिः वृवदअलइगन आदाय पवद ॱॱ अ६४ ददाति अ६४ आदि
